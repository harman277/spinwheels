          </section>
        )}

        {displayBlogs.length > 0 && (
          <section class="content-section" aria-labelledby="relatedBlogsHeading">
            <div class="section-header">
              <h2 class="section-title" id="relatedBlogsHeading">{slug ? "Helpful Guides & Ideas" : "Popular Guides & Playbooks"}</h2>
              <p class="section-subtitle">Step-by-step articles, setup templates, and fairness deep-dives from our editorial desk.</p>
            </div>
            <div class="related-blogs-grid">
              {displayBlogs.map((b: any) => (
                <a href={`/blogs/${b.slug}`} class="related-blog-card">
                  <span class="rb-tag">{b.tag}</span>
                  <h3>{b.title}</h3>
                  <span class="rb-link">Read Guide &rarr;</span>
                </a>
              ))}
            </div>
            {!slug && (
              <div style="text-align:center; margin-top:20px;">
                <a href="/blogs" class="btn-secondary" style="display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                  Browse All 25 Guides &rarr;
                </a>
              </div>
            )}
          </section>
        )}

        {langCode === "en" && CATEGORIES.length > 0 && (
          <section class="content-section" aria-labelledby="siloStripHeading">
            <div class="section-header">
              <h2 class="section-title" id="siloStripHeading">Browse All 8 Wheel Categories</h2>
              <p class="section-subtitle">Explore every curated collection across {totalWheelsCount} free online spin wheels.</p>
            </div>
            <div class="cat-silo-strip">
              {CATEGORIES.map((cat: any) => (
                <a href={`/category/${cat.slug}`} class={`cat-silo-pill ${activeCatObj && activeCatObj.slug === cat.slug ? "active" : ""}`}>
                  <span>{cat.icon}</span> {cat.name}
                </a>
              ))}
              <a href="/tools" class="cat-silo-pill">🔎 All {totalWheelsCount} Wheels</a>
            </div>
          </section>
        )}

        <div class="eeat-card" role="complementary" aria-label="Editorial Note">
          <div>
            {langCode === "en" ? (
              <>
                <strong>Editorial Note:</strong> Built and maintained by <a href="/about">Harman S. &amp; Editorial Contributors</a>.{" "}
                Last updated on <time datetime={REVIEWED_ISO}>{REVIEWED_TEXT}</time>.
              </>
            ) : (
              <>
                <strong>{uiChrome.editorialReviewLabel || "Editorial Review:"}</strong>{" "}
                {uiChrome.editorialVerifiedText || "Verified and fact-checked by the"}{" "}
                <a href="/about">{uiChrome.editorialTeamName || "Spin The Wheels Online Editorial Team"}</a>.{" "}
                {uiChrome.editorialAuditedLabel || "Last updated on"} <time datetime={REVIEWED_ISO}>{REVIEWED_ISO}</time>.
              </>
            )}
          </div>
          <div class="eeat-badge">{uiChrome.editorialBadge || "🛡️ Browser Web Cryptography • 100% Client-Side"}</div>
        </div>
      </div>
    </div>
  </main>

  <WheelModals lang={langMeta} t={customT} chrome={uiChrome} />
  <div class="embed-hide">
    <CookieBanner lang={langMeta} chrome={uiChrome} />
    <SiteFooter lang={langMeta} chrome={uiChrome} currentSlug={slug} currentPath={selfPath} />
  </div>

  <script src={ASSETS.jsHref} defer></script>
</body>
</html>

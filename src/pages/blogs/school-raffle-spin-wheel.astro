    <style is:inline>:root{--red:#e8391b;--red-dark:#c42e13;--gold:#f5a623;--dark:#111827;--text:#1f2937;--muted:#6b7280;--bg:#f9f8f5;--border:#e5e7eb;--card:#fff;--sidebar:#f3f2ef;--green:#16a34a;--blue:#1d4ed8;--amber:#d97706}*,::after,::before{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{font-family:Lora,Georgia,serif;background:var(--bg);color:var(--text);line-height:1.85;font-size:16px;overflow-x:hidden}img{max-width:100%;height:auto;display:block;border-radius:12px}a{color:var(--red);text-decoration:none}a:hover{text-decoration:underline}#read-progress{position:fixed;top:0;left:0;height:3px;background:var(--red);z-index:9999;width:0%;transition:width .1s}#back-top{position:fixed;bottom:clamp(16px,3vw,28px);right:clamp(16px,3vw,28px);width:clamp(38px,5vw,46px);height:clamp(38px,5vw,46px);border-radius:50%;background:var(--red);color:#fff;border:none;cursor:pointer;font-size:clamp(16px, 2.5vw, 20px);display:none;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(232,57,27,.4);transition:transform .2s;z-index:100}#back-top.show{display:flex}#back-top:hover{transform:translateY(-3px)}.breadcrumb-bar{background:#fff;border-bottom:1px solid var(--border)}.bc-inner{max-width:1240px;margin:0 auto;padding:9px clamp(14px,4vw,24px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:var(--muted);display:flex;align-items:center;flex-wrap:wrap;gap:2px}.bc-inner a{color:var(--red)}.bc-sep{margin:0 5px;color:#d1d5db}.post-hero{background:linear-gradient(135deg,#1a0a00 0,#7c2d12 45%,#1a1a00 100%);color:#fff;padding:clamp(36px,7vw,64px) clamp(16px,5vw,24px) clamp(32px,6vw,52px);text-align:center;position:relative;overflow:hidden}.post-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 22% 48%,rgba(217,119,6,.28),transparent 55%),radial-gradient(ellipse at 82% 24%,rgba(232,57,27,.2),transparent 50%)}.hero-tag{display:inline-block;background:var(--amber);color:#fff;font-family:"DM Sans",sans-serif;font-size:clamp(10px, 1.3vw, 11.5px);font-weight:700;text-transform:uppercase;letter-spacing:.12em;padding:5px clamp(12px,2vw,16px);border-radius:20px;margin-bottom:clamp(12px,2.5vw,20px);position:relative}.post-hero h1{font-family:"Playfair Display",serif;font-size:clamp(22px, 5vw, 48px);font-weight:900;max-width:900px;margin:0 auto clamp(12px,2.5vw,18px);line-height:1.16;position:relative}.post-hero h1 em{color:var(--gold);font-style:normal}.hero-sub{font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2.2vw, 17px);color:rgba(255,255,255,.72);max-width:680px;margin:0 auto clamp(18px,3vw,28px);position:relative}.post-meta{display:flex;align-items:center;justify-content:center;gap:clamp(8px,2vw,18px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:rgba(255,255,255,.55);flex-wrap:wrap;position:relative}.meta-dot{color:rgba(255,255,255,.25)}.updated-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(245,166,35,.15);border:1px solid rgba(245,166,35,.3);color:var(--gold);font-family:"DM Sans",sans-serif;font-size:clamp(11px, 1.4vw, 12px);font-weight:600;padding:5px 13px;border-radius:20px;margin-top:clamp(10px,2vw,16px);position:relative}.layout{max-width:1240px;margin:0 auto;padding:clamp(20px,4vw,40px) clamp(14px,4vw,24px) clamp(40px,6vw,60px);display:grid;grid-template-columns:1fr 330px;gap:clamp(24px,4vw,44px);align-items:start}article{background:var(--card);border-radius:14px;padding:clamp(20px,5vw,44px) clamp(18px,5vw,48px);box-shadow:0 1px 4px rgba(0,0,0,.06);min-width:0}.toc{background:#fafaf8;border:1px solid var(--border);border-left:4px solid var(--red);border-radius:0 12px 12px 0;padding:clamp(14px,3vw,22px) clamp(16px,3vw,26px);margin-bottom:clamp(24px,4vw,38px)}.toc-title{font-family:"DM Sans",sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:14px;font-weight:600}.toc ol{padding-left:18px;display:flex;flex-direction:column;gap:7px}.toc li{font-family:"DM Sans",sans-serif;font-size:clamp(13px, 1.6vw, 14px)}.toc a{color:var(--red);transition:color .15s}.toc a:hover{color:var(--red-dark)}article h2{font-family:"Playfair Display",serif;font-size:clamp(20px, 3.5vw, 26px);font-weight:800;color:var(--dark);margin:clamp(28px,5vw,44px) 0 clamp(10px,2vw,16px);padding-bottom:10px;border-bottom:2px solid #ede9e0;scroll-margin-top:20px;line-height:1.25}article h3{font-family:"DM Sans",sans-serif;font-size:clamp(16px, 2.5vw, 19px);font-weight:700;color:var(--dark);margin:clamp(18px,3vw,28px) 0 10px}article p{margin-bottom:18px;color:#2d3748;font-size:clamp(15px, 2vw, 16.5px)}article ol,article ul{padding-left:clamp(16px,3vw,22px);margin-bottom:18px;display:flex;flex-direction:column;gap:9px}article li{font-size:clamp(14.5px, 2vw, 16px);color:#2d3748;line-height:1.75}article strong{color:var(--dark)}.ilink{color:var(--red);font-weight:600;border-bottom:1px dashed rgba(232,57,27,.5);transition:border-color .2s}.ilink:hover{border-bottom-style:solid;text-decoration:none}figure.ai-image{margin:30px 0}figure.ai-image figcaption{font-family:"DM Sans",sans-serif;font-size:12.5px;color:var(--muted);margin-top:8px;text-align:center}.step-list{list-style:none!important;padding:0!important;counter-reset:steps}.step-list li{counter-increment:steps;display:flex;gap:clamp(12px,2.5vw,16px);padding:clamp(14px,2.5vw,20px) 0;border-bottom:1px solid #ede9e0}.step-list li:last-child{border:none}.step-num{width:clamp(32px,4.5vw,42px);height:clamp(32px,4.5vw,42px);background:var(--red);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:"DM Sans",sans-serif;font-weight:700;font-size:clamp(13px, 1.8vw, 16px);flex-shrink:0;margin-top:2px}.step-num::before{content:counter(steps)}.step-body strong{display:block;font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2vw, 16px);font-weight:700;margin-bottom:6px;color:var(--dark)}.step-body p{font-size:clamp(1
;font-size:.88rem}thead{background:var(--bg3)}th{padding:12px 16px;text-align:left;font-weight:700;color:var(--text);border-bottom:1px solid var(--border);white-space:nowrap}td{padding:11px 16px;color:var(--text-soft);border-bottom:1px solid var(--border);vertical-align:top}tr:last-child td{border-bottom:none}tr:nth-child(2n) td{background:rgba(255,255,255,.025)}.check{color:var(--green);font-size:1rem}.cross{color:var(--rose);font-size:1rem}.internal-links-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:28px 0}.internal-link-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;transition:border-color .2s,transform .15s;display:flex;flex-direction:column;gap:4px}.internal-link-card:hover{border-color:var(--border2);transform:translateY(-2px);text-decoration:none}.ilc-label{font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--text-muted)}.ilc-title{font-size:.9rem;color:#fff;font-weight:600;line-height:1.4}.ilc-meta{font-size:.78rem;color:var(--text-muted)}.wheel-cta{background:linear-gradient(135deg,rgba(108,99,255,.15) 0,rgba(56,189,248,.08) 100%);border:1px solid rgba(108,99,255,.3);border-radius:var(--radius);padding:28px 28px;text-align:center;margin:40px 0}.wheel-cta h3{font-size:1.15rem;color:#fff;margin-bottom:8px;font-family:var(--font-display);font-weight:400}.wheel-cta p{font-size:.9rem;color:var(--text-muted);margin-bottom:18px}.btn{display:inline-block;background:var(--accent);color:#fff!important;font-weight:700;padding:12px 28px;border-radius:24px;font-size:.9rem;transition:background .2s,transform .15s;text-decoration:none!important}.btn:hover{background:var(--accent2);transform:translateY(-1px)}.btn.outline{background:0 0;border:2px solid var(--accent);color:var(--accent2)!important;margin-left:8px}.btn.outline:hover{background:rgba(108,99,255,.12)}.faq{margin:12px 0}details.faq-item{border:1px solid var(--border);border-radius:var(--radius);margin-bottom:10px;overflow:hidden;background:var(--bg2)}details.faq-item summary{list-style:none;cursor:pointer;padding:16px 20px;font-weight:600;font-size:.95rem;color:var(--text);display:flex;justify-content:space-between;align-items:center;gap:12px}details.faq-item summary::-webkit-details-marker{display:none}details.faq-item summary::after{content:"+";color:var(--text-muted);font-size:1.1rem;flex-shrink:0;transition:transform .3s}details.faq-item[open] summary::after{content:"×";color:var(--accent2);transform:rotate(0)}details.faq-item .faq-a{padding:4px 20px 18px;color:var(--text-soft);font-size:.92rem;line-height:1.7;border-top:1px solid var(--border);padding-top:14px}details.faq-item .faq-a p{margin-bottom:8px}details.faq-item .faq-a p:last-child{margin-bottom:0}details.faq-item .faq-a a{color:var(--accent2)}.related-section{margin-top:48px}.related-section h3{font-size:1rem;font-weight:700;color:var(--text-muted);letter-spacing:.05em;text-transform:uppercase;margin-bottom:14px}.related-list{list-style:none;padding:0}.related-list li{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}.related-list li:last-child{border-bottom:none}.related-num{font-size:.78rem;font-weight:700;color:var(--text-muted);min-width:22px;padding-top:2px}.related-list a{color:var(--text);font-size:.9rem;font-weight:600;line-height:1.4}.related-list a:hover{color:var(--accent2);text-decoration:none}.related-meta{font-size:.78rem;color:var(--text-muted);margin-top:2px}.takeaways{background:var(--bg2);border:1px solid rgba(52,211,153,.25);border-radius:var(--radius);padding:22px 24px;margin:36px 0}.takeaways-title{font-weight:700;color:var(--green);font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:14px}.takeaways ul{padding-left:18px}.takeaways li{color:var(--text-soft);font-size:.9rem;margin-bottom:8px}.takeaways li:last-child{margin-bottom:0}.share-row{display:flex;align-items:center;gap:12
    <style is:inline>:root{--accent:#6d28d9;--accent-dark:#4c1d95;--accent-light:#8b5cf6;--neon:#a855f7;--gold:#f59e0b;--red:#ef4444;--teal:#0d9488;--dark:#0f0f17;--dark2:#1a1a2e;--text:#1e1e2e;--muted:#6b7280;--bg:#f8f7ff;--border:#e5e7eb;--card:#ffffff;--sidebar:#f3f0ff;--green:#16a34a;--blue:#2563eb;--orange:#ea580c;--twitch:#9146ff;--youtube:#ff0000;--youtube-dark:#cc0000}*,::after,::before{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{font-family:Lora,Georgia,serif;background:var(--bg);color:var(--text);line-height:1.85;font-size:16px;overflow-x:hidden}img{max-width:100%;height:auto;display:block;border-radius:12px}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}#read-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--twitch),var(--youtube));z-index:9999;width:0%;transition:width .1s}#back-top{position:fixed;bottom:clamp(16px,3vw,28px);right:clamp(16px,3vw,28px);width:clamp(38px,5vw,46px);height:clamp(38px,5vw,46px);border-radius:50%;background:var(--accent);color:#fff;border:none;cursor:pointer;font-size:clamp(16px, 2.5vw, 20px);display:none;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(109,40,217,.45);transition:transform .2s;z-index:100}#back-top.show{display:flex}#back-top:hover{transform:translateY(-3px)}.topbar{background:var(--dark);color:#9ca3af;font-family:"DM Sans",sans-serif;font-size:clamp(11px, 1.5vw, 12.5px);text-align:center;padding:7px 16px;letter-spacing:.03em;line-height:1.6}.topbar a{color:var(--gold);font-weight:600}.topbar a:hover{color:#fff;text-decoration:none}header{background:#fff;border-bottom:3px solid var(--accent);position:sticky;top:0;z-index:200;box-shadow:0 2px 16px rgba(0,0,0,.08)}.header-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(14px,4vw,24px);display:flex;align-items:center;justify-content:space-between;height:clamp(54px,8vw,66px);gap:12px}.logo{font-family:"Playfair Display",serif;font-size:clamp(14px, 2.5vw, 20px);font-weight:900;color:var(--dark);text-decoration:none;display:flex;align-items:center;gap:7px;flex-shrink:0;white-space:nowrap}.logo-emoji{display:inline-block;animation:spin-slow 6s linear infinite}@keyframes spin-slow{to{transform:rotate(360deg)}}nav{display:flex;align-items:center;gap:2px;flex-wrap:wrap}nav a{font-family:"DM Sans",sans-serif;font-size:clamp(12px, 1.4vw, 14px);font-weight:500;color:var(--text);padding:7px clamp(8px,1.2vw,12px);border-radius:7px;transition:all .18s;white-space:nowrap}nav a:hover{background:#f3f4f6;color:var(--accent);text-decoration:none}nav a.active{color:var(--accent);font-weight:600}.hamburger{display:none;cursor:pointer;font-size:clamp(20px, 4vw, 24px);color:var(--dark);background:0 0;border:none;padding:6px;border-radius:6px;line-height:1;flex-shrink:0}.hamburger:hover{background:#f3f4f6}.mobile-nav{display:none;flex-direction:column;background:#fff;border-top:1px solid var(--border);padding:8px clamp(14px,4vw,20px) 16px}.mobile-nav.open{display:flex;animation:slideDown .2s ease}@keyframes slideDown{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}.mobile-nav a{font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2vw, 15px);padding:11px 0;border-bottom:1px solid var(--border);color:var(--text)}.mobile-nav a:last-child{border-bottom:none}.mobile-nav a:hover{color:var(--accent);text-decoration:none}.breadcrumb-bar{background:#fff;border-bottom:1px solid var(--border)}.bc-inner{max-width:1240px;margin:0 auto;padding:9px clamp(14px,4vw,24px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:var(--muted);display:flex;align-items:center;flex-wrap:wrap;gap:2px}.bc-inner a{color:var(--accent)}.bc-sep{margin:0 5px;color:#d1d5db}.post-hero{background:linear-gradient(135deg,#0f0f17 0,#1a0a2e 50%,#0a0a1a 100%);color:#fff;padding:clamp(36px,7vw,72px) clamp(16px,5vw,24px) clamp(36px,6vw,60px);text-align:center;position:relative;overflow:hidden}.post-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 15% 55%,rgba(145,70,255,.28),transparent 50%),radial-gradient(ellipse at 85% 25%,rgba(255,0,0,.15),transparent 50%),radial-gradient(ellipse at 55% 85%,rgba(109,40,217,.15),transparent 55%)}.post-hero::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,.012) 3px,rgba(255,255,255,.012) 4px);pointer-events:none}.hero-floats{position:absolute;inset:0;pointer-events:none;overflow:hidden}.hero-floats span{position:absolute;font-size:clamp(16px, 2.5vw, 28px);animation:floatUp 9s infinite ease-in-out;opacity:.13}.hero-floats span:first-child{left:4%;top:18%;animation-delay:0s}.hero-floats span:nth-child(2){left:14%;top:72%;animation-delay:1.4s}.hero-floats span:nth-child(3){left:88%;top:14%;animation-delay:.6s}.hero-floats span:nth-child(4){left:76%;top:76%;animation-delay:2.2s}.hero-floats span:nth-child(5){left:53%;top:86%;animation-delay:3.1s}.hero-floats span:nth-child(6){left:94%;top:44%;animation-delay:1.9s}.hero-floats span:nth-child(7){left:33%;top:8%;animation-delay:.9s}.hero-floats span:nth-child(8){left:65%;top:32%;animation-delay:2.6s}@keyframes floatUp{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-16px) rotate(4deg)}}.hero-tag{display:inline-block;background:var(--twitch);color:#fff;font-family:"DM Sans",sans-serif;font-size:clamp(10px, 1.3vw, 11.5px);font-weight:700;text-transform:uppercase;letter-spacing:.12em;padding:5px clamp(12px,2vw,16px);border-radius:20px;margin-bottom:clamp(12px,2.5vw,20px);position:relative}.post-hero h1{font-family:"Playfair Display",serif;font-size:clamp(22px, 5vw, 48px);font-weight:900;max-width:960px;margin:0 auto clamp(12px,2.5vw,18px);line-height:1.14;position:relative}.post-hero h1 em{color:var(--gold);font-style:normal}.hero-sub{font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2.2vw, 17px);color:rgba(255,255,255,.7);max-width:700px;margin:0 auto clamp(18px,3vw,28px);position:relative}.post-meta{display:flex;align-items:center;justify-content:center;gap:clamp(8px,2vw,18px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:rgba(255,255,255,.5);flex-wrap:wrap;position:relative}.meta-dot{color:rgba(255,255,255,.22)}.updated-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.3);color:var(--gold);font-family:"DM Sans",sans-serif;font-size:clamp(11px, 1.4vw, 12px);font-weight:600;padding:5px 13px;border-radius:20px;margin-top:clamp(10px,2vw,16px);position:relative}.hero-image{max-width:760px;margin:clamp(20px,3vw,32px) auto 0;position:relative;z-index:1;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5)}.hero-image img{border-radius:16px}.platform-badge{display:inline-flex;align-items:center;gap:6px;font-family:"DM Sans",sans-serif;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:20px;margin-bottom:14px}.badge-twitch{background:var(--twitch);color:#fff}.badge-youtube{background:var(--youtube);color:#fff}.badge-both{background:linear-gradient(90deg,var(--twitch),var(--youtube));color:#fff}.badge-tiktok{background:#111;color:#fff;border:1px solid #333}.layout{max-width:1240px;margin:0 auto;padding:clamp(20px,4vw,40px) clamp(14px,4vw,24px) clamp(40px,6vw,60px);display:grid;grid-template-columns:1fr 330px;gap:clamp(24px,4vw,44px);align-items:start}article{background:var(--card);border-radius:14px;padding:clamp(20px,5vw,44px) clamp(18px,5vw,48px);box-shadow:0 1px 4px rgba(0,0,0,.06);min-width:0}.toc{background:#faf7ff;border:1px solid #ddd6fe;border-left:4px solid var(--accent);border-radius:0 12px 12px 0;padding:clamp(14px,3vw,22px) clamp(16px,3vw,26px);margin-bottom:clamp(24px,4vw,38px)}.toc-title{font-family:"DM Sans",sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bott
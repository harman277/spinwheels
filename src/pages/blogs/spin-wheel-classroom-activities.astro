ound:#eff6ff;border:1px solid #bfdbfe;border-left:4px solid var(--blue)}.box-success{background:#f0fdf4;border:1px solid #bbf7d0;border-left:4px solid var(--green)}.box-purple{background:#f5f3ff;border:1px solid #ddd6fe;border-left:4px solid var(--purple)}.box-label{font-family:"DM Sans",sans-serif;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;display:flex;align-items:center;gap:6px}.box-tip .box-label{color:#92400e}.box-info .box-label{color:#1e40af}.box-success .box-label{color:#166534}.box-purple .box-label{color:#5b21b6}.box p{margin:0;font-size:clamp(14px, 2vw, 15.5px)}.box ul{margin:0;font-size:clamp(13.5px, 2vw, 15px)}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0}.info-card{background:var(--sidebar);border-radius:10px;padding:clamp(12px,2.5vw,18px) clamp(14px,2.5vw,20px);border:1px solid var(--border);transition:transform .2s,box-shadow .2s}.info-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.08)}.ic-icon{font-size:clamp(20px, 3vw, 26px);margin-bottom:10px}.info-card h3,.info-card h4{font-family:"DM Sans",sans-serif;font-size:clamp(13px, 1.8vw, 14px);font-weight:700;margin-bottom:5px;color:var(--dark)}.info-card p{font-size:clamp(12.5px, 1.8vw, 13.5px);color:var(--muted);margin:0}.idea-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0}.idea-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:clamp(14px,2.5vw,20px);border-top:4px solid var(--green);transition:transform .2s,box-shadow .2s}.idea-card:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(0,0,0,.09)}.idea-card .ic-num{font-family:"Playfair Display",serif;font-size:clamp(22px, 3.5vw, 28px);font-weight:900;color:var(--green);line-height:1;margin-bottom:6px}.idea-card h3,.idea-card h4{font-family:"DM Sans",sans-serif;font-size:clamp(13.5px, 2vw, 15px);font-weight:700;color:var(--dark);margin-bottom:7px}.idea-card p{font-size:clamp(12.5px, 1.8v
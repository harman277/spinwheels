    <style is:inline>:root{--blue:#2563eb;--blue-dark:#1d4ed8;--blue-light:#3b82f6;--indigo:#4f46e5;--gold:#f59e0b;--dark:#0a0f1e;--dark2:#1e293b;--text:#1e293b;--muted:#64748b;--bg:#f8f9ff;--border:#e2e8f0;--card:#ffffff;--sidebar:#f0f4ff;--green:#16a34a;--teal:#0d9488;--red:#dc2626;--orange:#ea580c;--purple:#7c3aed;--cyan:#0891b2}*,::after,::before{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{font-family:Lora,Georgia,serif;background:var(--bg);color:var(--text);line-height:1.85;font-size:16px;overflow-x:hidden}img{max-width:100%;height:auto;display:block}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}#read-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--indigo),var(--purple));z-index:9999;width:0%;transition:width .1s}#back-top{position:fixed;bottom:clamp(16px,3vw,28px);right:clamp(16px,3vw,28px);width:clamp(38px,5vw,46px);height:clamp(38px,5vw,46px);border-radius:50%;background:var(--blue);color:#fff;border:none;cursor:pointer;font-size:clamp(16px, 2.5vw, 20px);display:none;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,99,235,.4);transition:transform .2s;z-index:100}#back-top.show{display:flex}#back-top:hover{transform:translateY(-3px)}.breadcrumb-bar{background:#fff;border-bottom:1px solid var(--border)}.bc-inner{max-width:1240px;margin:0 auto;padding:9px clamp(14px,4vw,24px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:var(--muted);display:flex;align-items:center;flex-wrap:wrap;gap:2px}.bc-inner a{color:var(--blue)}.bc-sep{margin:0 5px;color:#cbd5e1}.post-hero{background:linear-gradient(135deg,#04081a 0,#0d1b4a 50%,#080d2a 100%);color:#fff;padding:clamp(36px,7vw,72px) clamp(16px,5vw,24px) clamp(36px,6vw,60px);text-align:center;position:relative;overflow:hidden}.post-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 20% 50%,rgba(37,99,235,.28),transparent 52%),radial-gradient(ellipse at 80% 25%,rgba(79,70,229,.22),transparent 50%),radial-gradient(ellipse at 55% 88%,rgba(8,145,178,.14),transparent 55%)}.post-hero::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:40px 40px;pointer-events:none}.hero-floats{position:absolute;inset:0;pointer-events:none;overflow:hidden}.hero-floats span{position:absolute;font-size:clamp(14px, 2.2vw, 24px);animation:floatUp 9s infinite ease-in-out;opacity:.11}.hero-floats span:first-child{left:4%;top:20%;animation-delay:0s}.hero-floats span:nth-child(2){left:13%;top:72%;animation-delay:1.4s}.hero-floats span:nth-child(3){left:88%;top:15%;animation-delay:.6s}.hero-floats span:nth-child(4){left:77%;top:75%;animation-delay:2.2s}.hero-floats span:nth-child(5){left:52%;top:86%;animation-delay:3.1s}.hero-floats span:nth-child(6){left:93%;top:44%;animation-delay:1.9s}.hero-floats span:nth-child(7){left:34%;top:8%;animation-delay:.9s}.hero-floats span:nth-child(8){left:63%;top:34%;animation-delay:2.7s}@keyframes floatUp{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-16px) rotate(4deg)}}.hero-tag{display:inline-block;background:var(--blue);color:#fff;font-family:"DM Sans",sans-serif;font-size:clamp(10px, 1.3vw, 11.5px);font-weight:700;text-transform:uppercase;letter-spacing:.12em;padding:5px clamp(12px,2vw,16px);border-radius:20px;margin-bottom:clamp(12px,2.5vw,20px);position:relative}.post-hero h1{font-family:"Playfair Display",serif;font-size:clamp(22px, 5vw, 50px);font-weight:900;max-width:980px;margin:0 auto clamp(12px,2.5vw,18px);line-height:1.14;position:relative}.post-hero h1 em{color:var(--gold);font-style:normal}.hero-sub{font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2.2vw, 17px);color:rgba(255,255,255,.7);max-width:720px;margin:0 auto clamp(18px,3vw,28px);position:relative}.post-meta{display:flex;align-items:center;justify-content:center;gap:clamp(8px,2vw,18px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:rgba(255,255,255,.5);flex-wrap:wrap;position:relative}.meta-dot{color:rgba(255,255,255,.22)}.updated-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.3);color:var(--gold);font-family:"DM Sans",sans-serif;font-size:clamp(11px, 1.4vw, 12px);font-weight:600;padding:5px 13px;border-radius:20px;margin-top:clamp(10px,2vw,16px);position:relative}.hero-image-wrap{max-width:880px;margin:clamp(22px,4vw,34px) auto 0;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.12);box-shadow:0 20px 60px rgba(0,0,0,.45);position:relative}.hero-image-wrap img{width:100%;display:block}.verdict{display:inline-flex;align-items:center;gap:7px;font-family:"DM Sans",sans-serif;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:5px 14px;border-radius:20px}.verdict-yes{background:#dcfce7;color:#166534;border:1.5px solid #86efac}.verdict-no{background:#fee2e2;color:#991b1b;border:1.5px solid #fca5a5}.verdict-part{background:#fef9c3;color:#78350f;border:1.5px solid #fde047}.layout{max-width:1240px;margin:0 auto;padding:clamp(20px,4vw,40px) clamp(14px,4vw,24px) clamp(40px,6vw,60px);display:grid;grid-template-columns:1fr 330px;gap:clamp(24px,4vw,44px);align-items:start}article{background:var(--card);border-radius:14px;padding:clamp(20px,5vw,44px) clamp(18px,5vw,48px);box-shadow:0 1px 4px rgba(0,0,0,.06);min-width:0}.toc{background:#f0f4ff;border:1px solid #bfdbfe;border-left:4px solid var(--blue);border-radius:0 12px 12px 0;padding:clamp(14px,3vw,22px) clamp(16px,3vw,26px);margin-bottom:clamp(24px,4vw,38px)}.toc-title{font-family:"DM Sans",sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:14px;font-weight:600}.toc ol{padding-left:18px;display:flex;flex-direction:column;gap:7px}.toc li{font-family:"DM Sans",sans-serif;font-size:clamp(13px, 1.6vw, 14px)}.toc a{color:var(--blue);transition:color .15s}.toc a:hover{color:var(--blue-dark)}article h2{font-family:"Playfair Display",serif;font-size:clamp(20px, 3.5vw, 26px);font-weight:800;color:var(--dark);margin:clamp(28px,5vw,44px) 0 clamp(10px,2vw,16px);padding-bottom:10px;border-bottom:2px solid #dbeafe;scroll-margin-top:82px;line-height:1.25}article h3{font-family:"DM Sans",sans-serif;font-size:clamp(16px, 2.5vw, 19px);font-weight:700;color:var(--dark);margin:clamp(18px,3vw,28px) 0 10px}article p{margin-bottom:18px;color:#1e2a4a;font-size:clamp(15px, 2vw, 16.5px)}article ol,article ul{padding-left:clamp(16px,3vw,22px);margin-bottom:18px;display:flex;flex-direction:column;gap:9px}article li{font-size:clamp(14.5px, 2vw, 16px);color:#1e2a4a;line-height:1.75}article strong{color:var(--dark)}article figure{margin:26px 0}article figure img{border-radius:12px;border:1px solid var(--border)}article figcaption{font-family:"DM Sans",sans-serif;font-size:12.5px;color:var(--muted);text-align:center;margin-top:8px}.ilink{color:var(--blue);font-weight:600;border-bottom:1px dashed rgba(37,99,235,.4);transition:border-color .2s}.ilink:hover{border-bottom-style:solid;text-decoration:none}.q-card{border:1px solid var(--border);border-radius:14px;padding:clamp(20px,3.5vw,32px) clamp(18px,3.5vw,30px);margin:clamp(28px,4vw,40px) 0;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.05);position:relative;overflow:hidden}.q-card::before{content:"";position:absolute;top:0;left:0;right:0;height:4px}.q-card.yes::before{background:linear-gradient(90deg,var(--green),#4ade80)}.q-card.no::before{background:linear-gradient(90deg,var(--red),#f87171)}.q-card.partly::before{background:linear-gradient(90deg,var(--gold),#fbbf24)}.q-card.info::before{background:linear-gradient(90deg,var(--blue),var(--indigo))}.q-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:16px;flex-wrap:wrap}.
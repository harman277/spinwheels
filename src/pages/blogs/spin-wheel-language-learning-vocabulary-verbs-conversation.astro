          <figcaption>
            A well-built wheel turns repetitive vocabulary and grammar drills
            into something learners actually look forward to.
          </figcaption>
        </figure>
      </header>

      <!-- ARTICLE BODY -->
      <main class="article-body" id="mainContent">
        <!-- MOBILE TOC -->
        <div class="toc-mobile">
          <button class="toc-mobile-toggle" id="tocMobileToggle">
            📋 Table of Contents <span class="arrow">▾</span>
          </button>
          <div class="toc-mobile-content" id="tocMobileContent">
            <ol>

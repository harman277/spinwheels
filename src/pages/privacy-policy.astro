---
import { LANGUAGES, TRANSLATIONS } from "../data/i18n.js";
import { getChrome } from "../data/i18n-chrome.js";
import { SITE_URL, SITE_NAME, REVIEWED_ISO, ASSETS } from "../config/site";
import AnalyticsHead from "../components/AnalyticsHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WheelModals from "../components/WheelModals.astro";
import CookieBanner from "../components/CookieBanner.astro";

const lang = (LANGUAGES as any).en;
const t = (TRANSLATIONS as any).en;
const uiChrome = getChrome("en");

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: SITE_NAME, url: SITE_URL, logo: { "@type": "ImageObject", url: `${SITE_URL}/logo-512x512.png`, width: 512, height: 512 }, contactPoint: { "@type": "ContactPoint", contactType: "customer support", email: "spinthewheelsonline@gmail.com", url: `${SITE_URL}/contact` } },
    { "@type": "WebSite", "@id": `${SITE_URL}/#website`, name: SITE_NAME, url: SITE_URL, publisher: { "@id": `${SITE_URL}/#organization` } },
    { "@type": "WebPage", "@id": `${SITE_URL}/privacy-policy#webpage`, name: "Privacy Policy – Spin The Wheels Online", url: `${SITE_URL}/privacy-policy`, description: "Privacy policy and regulatory compliance disclosures for Spin The Wheels Online, including browser-local wheel storage, cookies, Google AdSense, GDPR, CCPA, and COPPA.", dateModified: REVIEWED_ISO, inLanguage: "en", isPartOf: { "@id": `${SITE_URL}/#website` }, publisher: { "@id": `${SITE_URL}/#organization` }, breadcrumb: { "@id": `${SITE_URL}/privacy-policy#breadcrumbs` } },
    { "@type": "BreadcrumbList", "@id": `${SITE_URL}/privacy-policy#breadcrumbs`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` }, { "@type": "ListItem", position: 2, name: "Privacy Policy", item: `${SITE_URL}/privacy-policy` }] }
  ]
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Privacy Policy – Spin The Wheels Online</title>
  <meta name="description" content="Privacy Policy for Spin The Wheels Online: details on browser-local wheel storage, cookies, Google AdSense, GDPR, CCPA rights, and opt-out controls." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={`${SITE_URL}/privacy-policy`} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#F59E0B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" /></noscript>
  <link rel="stylesheet" href={ASSETS.cssHref} />
  <AnalyticsHead enableAds={false} />
  <script type="application/ld+json" set:html={schemaJson} />
</head>
<body>
  <SiteHeader lang={lang} t={t} chrome={uiChrome} currentPath="/privacy-policy" />
  <main class="container" style="max-width: 860px; padding: 48px 20px;">
    <article class="card" style="padding: clamp(24px, 5vw, 44px);">
      <h1 class="section-title" style="text-align: left; margin-bottom: 8px;">Privacy <span>Policy</span></h1>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 24px;">Effective Date: January 1, 2025 · Last Updated: November 28, 2026</p>
      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.75; margin-bottom: 20px;">
        At <strong>Spin The Wheels Online</strong> ("we", "us", or "our"), accessible from <strong>https://spinthewheelsonline.com</strong>, we are committed to safeguarding your privacy across classrooms, workplaces, livestreams, and households worldwide. This Privacy Policy explains what information stays strictly on your own device, what limited technical and advertising cookies may be processed, and how to exercise your rights under the European Union General Data Protection Regulation (GDPR), the UK Data Protection Act, the California Consumer Privacy Act (CCPA/CPRA), and the Children's Online Privacy Protection Act (COPPA).
      </p>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">1. Data We Do NOT Collect (100% Client-Side Wheel Isolation)</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 14px;">
        <strong>Your custom wheel entries—including student names, employee rosters, giveaway participant handles, raffle ticket numbers, and personal decision lists—remain strictly inside your local browser memory and your device's <code>localStorage</code>.</strong>
      </p>
      <ul style="margin: 0 0 18px 24px; color: var(--text-secondary); line-height: 1.75;">
        <li>When you type or paste entries into any of our <a href="/tools">69 spin wheels</a>, those entries are rendered locally on your screen via HTML5 Canvas and JavaScript.</li>
        <li>Your wheel entries, custom 1x–20x slice weights, and spin history CSV logs are never transmitted to our servers, never stored in any remote database, and never shared with or sold to third parties.</li>
        <li>If you voluntarily click <em>Share Wheel</em> or generate a QR code, your slice labels are encoded directly into the URL query string (<code>?w=...</code>) so that only the people you share that exact link with can open your list.</li>
      </ul>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">2. LocalStorage &amp; Essential Functional Preferences</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px;">
        To provide a seamless experience without requiring user accounts or passwords, your browser stores lightweight preference keys locally on your device:
      </p>
      <ul style="margin: 0 0 18px 24px; color: var(--text-secondary); line-height: 1.75;">
        <li><code>stwol_entries_[path]</code> &amp; <code>stwol_saved_wheels</code>: Keeps your active and named custom wheels saved on your device across page refreshes.</li>
        <li><code>stwol_theme</code>, <code>stwol_theme_mode</code>, <code>stwol_volume</code>, &amp; <code>stwol_muted</code>: Remembers your selected color palette, dark/light mode, and audio mute setting.</li>
        <li><code>stwol_consent</code> &amp; <code>stwol_pref_lang</code>: Stores your cookie consent choice and interface language preference.</li>
      </ul>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px;">
        You can clear these local keys at any time by clicking <em>Clear All</em> or <em>Reset to Default Entries</em> inside the wheel control panel, or by clearing site data in your browser settings.
      </p>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">3. Log Files, Edge CDN Delivery &amp; Contact Correspondence</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px;">
        Our static pages are delivered globally via Cloudflare Pages Edge CDN. Like nearly all web servers, standard infrastructure logs temporarily record technical request metadata—including anonymized IP address, browser user-agent, referring URL, requested page path, and timestamp—strictly to mitigate distributed denial-of-service (DDoS) attacks, diagnose broken links, and maintain low-latency delivery. If you contact us via our <a href="/contact">Contact page</a> or email <code>spinthewheelsonline@gmail.com</code>, we use your name, email address, and message content solely to reply to your inquiry and resolve your support request.
      </p>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">4. Google Analytics 4 &amp; Google Consent Mode v2</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px;">
        We use Google Analytics 4 (GA4) with <strong>Google Consent Mode v2</strong> enabled by default to understand aggregate page traffic, device screen categories, and which specialized wheels are most helpful to visitors. Until you explicitly click <strong>"Accept All"</strong> on our cookie banner, analytics and advertising storage default to <code>denied</code>. You can change your consent preference at any time by clearing your browser's site storage or selecting <strong>"Reject Non-Essential"</strong>.
      </p>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">5. Google AdSense &amp; Third-Party Advertising Disclosures</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 12px;">
        To keep Spin The Wheels Online 100% free for teachers, students, event hosts, and families without paywalls or subscriptions, we display advertisements served by <strong>Google AdSense</strong> on eligible content pages (ads are strictly disabled on <code>?embed=1</code> classroom/stream widgets and legal pages):
      </p>
      <ul style="margin: 0 0 18px 24px; color: var(--text-secondary); line-height: 1.75;">
        <li>Third-party vendors, including Google, use cookies (such as the DoubleClick DART cookie) to serve ads based on a user's prior visits to our website or other websites on the Internet.</li>
        <li>Google's use of advertising cookies enables it and its partners to serve personalized or non-personalized ads to users based on their visit to our site and/or other sites on the Internet.</li>
        <li>Users may opt out of personalized advertising at any time by choosing <em>Reject Non-Essential</em> on our consent banner, by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ads Settings</a>, or by visiting <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener">www.aboutads.info/choices</a> (or <a href="https://www.youronlinechoices.eu/" target="_blank" rel="noopener">YourOnlineChoices.eu</a> in Europe).</li>
      </ul>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">6. Classroom Privacy (FERPA / COPPA) &amp; Children's Information</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px;">
        Our tools are widely used by K–12 educators on interactive whiteboards and school Chromebooks. Because Spin The Wheels Online requires zero registration and processes student names exclusively in local browser memory without transmitting rosters over the network, schools retain complete local custody of classroom lists. We do not knowingly collect, store, or solicit personal information from children under the age of 13. If a parent, guardian, or teacher believes a child under 13 has sent personal information through our support email, please contact us immediately at <a href="mailto:spinthewheelsonline@gmail.com">spinthewheelsonline@gmail.com</a> and we will permanently delete that correspondence from our inbox.
      </p>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">7. Your GDPR, UK GDPR &amp; CCPA/CPRA Privacy Rights</h2>
      <p style="color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px;">
        Depending on your location (including the European Economic Area, the United Kingdom, Brazil under LGPD, and California under CCPA/CPRA), you have the right to request access to, correction of, or deletion of any personal correspondence you have sent us; the right to withdraw cookie consent; and the right to opt out of personalized advertising. We do not sell personal information to third parties.
      </p>

      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">8. Contact Our Privacy &amp; Editorial Desk</h2>
      <p style="color: var(--text-secondary); line-height: 1.75;">
        If you have any questions about this Privacy Policy, our client-side storage architecture, or your data rights, please contact us:<br />
        <strong>Email:</strong> <a href="mailto:spinthewheelsonline@gmail.com">spinthewheelsonline@gmail.com</a><br />
        <strong>Contact Form:</strong> <a href="https://spinthewheelsonline.com/contact">https://spinthewheelsonline.com/contact</a><br />
        <strong>About &amp; Editorial Standards:</strong> <a href="https://spinthewheelsonline.com/about">https://spinthewheelsonline.com/about</a>
      </p>
    </article>
  </main>
  <WheelModals lang={lang} t={t} chrome={uiChrome} />
  <CookieBanner lang={lang} chrome={uiChrome} />
  <SiteFooter lang={lang} chrome={uiChrome} currentPath="/privacy-policy" />
  <script src={ASSETS.jsHref} defer></script>
</body>
</html>

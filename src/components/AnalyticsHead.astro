---
import { ADS_CONFIG } from "../config/ads";

interface Props {
  enableAds?: boolean;
  isEmbedMode?: boolean;
}

const { enableAds = true, isEmbedMode = false } = Astro.props;
const showAds = Boolean(enableAds && !isEmbedMode && ADS_CONFIG.enableAutoAds);
---

<!-- Pre-paint ?embed=1 detection (works both on Cloudflare Edge and local static preview) -->
<script is:inline>
  (function () {
    try {
      var sp = new URLSearchParams(window.location.search);
      if (sp.get("embed") === "1") {
        document.documentElement.classList.add("embed-mode");
        var meta = document.querySelector('meta[name="robots"]');
        if (meta) meta.setAttribute("content", "noindex, follow");
      } else if (sp.has("w")) {
        var metaW = document.querySelector('meta[name="robots"]');
        if (metaW) metaW.setAttribute("content", "noindex, follow");
      }
    } catch (e) {}
  })();
</script>

<!-- Google Consent Mode v2 & Google Analytics 4 -->
<script is:inline define:vars={{ ga4Id: ADS_CONFIG.ga4Id }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  (function(){
    var saved = null;
    try { saved = localStorage.getItem('stwol_consent'); } catch (e) {}
    var granted = saved === 'all' ? 'granted' : 'denied';
    gtag('consent', 'default', {
      ad_storage: granted,
      ad_user_data: granted,
      ad_personalization: granted,
      analytics_storage: granted,
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500
    });
    if (saved === 'essential') {
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.requestNonPersonalizedAds = 1;
    }
  })();
  gtag('js', new Date());
  gtag('config', ga4Id);
</script>
<script async src={`https://www.googletagmanager.com/gtag/js?id=${ADS_CONFIG.ga4Id}`}></script>

{showAds && (
  <!-- Google AdSense Official Auto Ads Script (strictly disabled in ?embed=1 and 404) -->
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS_CONFIG.publisherId}`}
    crossorigin="anonymous"
  ></script>
)}

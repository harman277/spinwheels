---
import { LANGUAGES, TRANSLATIONS } from "../data/i18n.js";
import { getChrome } from "../data/i18n-chrome.js";
import { SITE_URL, SITE_NAME, REVIEWED_ISO, ASSETS } from "../config/site";
import AnalyticsHead from "../components/AnalyticsHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WheelModals from "../components/WheelModals.astro";
import CookieBanner from "../components/CookieBanner.astro";

const lang = (LANGUAGES as any).en;
const t = (TRANSLATIONS as any).en;
const uiChrome = getChrome("en");

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: SITE_NAME, url: SITE_URL, logo: { "@type": "ImageObject", url: `${SITE_URL}/logo-512x512.png`, width: 512, height: 512 }, contactPoint: { "@type": "ContactPoint", contactType: "customer support", email: "spinthewheelsonline@gmail.com", url: `${SITE_URL}/contact` } },
    { "@type": "WebSite", "@id": `${SITE_URL}/#website`, name: SITE_NAME, url: SITE_URL, publisher: { "@id": `${SITE_URL}/#organization` } },
    { "@type": "WebPage", "@id": `${SITE_URL}/terms-and-conditions#webpage`, name: "Terms and Conditions", url: `${SITE_URL}/terms-and-conditions`, description: "Terms and Conditions governing the use of Spin The Wheels Online.", dateModified: REVIEWED_ISO, inLanguage: "en", isPartOf: { "@id": `${SITE_URL}/#website` }, publisher: { "@id": `${SITE_URL}/#organization` }, breadcrumb: { "@id": `${SITE_URL}/terms-and-conditions#breadcrumbs` } },
    { "@type": "BreadcrumbList", "@id": `${SITE_URL}/terms-and-conditions#breadcrumbs`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` }, { "@type": "ListItem", position: 2, name: "Terms and Conditions", item: `${SITE_URL}/terms-and-conditions` }] }
  ]
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Terms and Conditions – Spin The Wheels Online</title>
  <meta name="description" content="Terms and Conditions of use for Spin The Wheels Online. Please read these terms before using our free online spin wheel tools." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={`${SITE_URL}/terms-and-conditions`} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#F59E0B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" /></noscript>
  <link rel="stylesheet" href={ASSETS.cssHref} />
  <AnalyticsHead enableAds={false} />
  <script type="application/ld+json" set:html={schemaJson} />
</head>
<body>
  <SiteHeader lang={lang} t={t} chrome={uiChrome} currentPath="/terms-and-conditions" />
  <main class="container" style="max-width: 860px; padding: 48px 20px;">
    <article class="card" style="padding: clamp(24px, 5vw, 44px);">
      <h1 class="section-title" style="text-align: left; margin-bottom: 8px;">Terms and <span>Conditions</span></h1>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 24px;">Last Updated: November 24, 2026</p>
      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 20px;">
        Welcome to <strong>Spin The Wheels Online</strong>. By accessing or using <strong>https://spinthewheelsonline.com</strong>, you agree to these Terms and Conditions.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">1. Permitted Use</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        Spin The Wheels Online provides free browser-based wheel spinners for educational demonstrations, entertainment, classroom moderation, personal decision-making, and informal giveaways.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">2. Sweepstakes, Giveaways &amp; Raffles Disclaimer</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        While our tool uses browser Web Cryptography randomness, <strong>Spin The Wheels Online is not a gambling operator, lottery authority, or regulated sweepstakes administrator</strong>. Organizers running commercial giveaways or raffles remain solely responsible for local compliance, eligibility rules, and tax obligations.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">3. Intellectual Property &amp; Disclaimer</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        All original software, designs, and written editorial guides belong to Spin The Wheels Online. The service is provided on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">4. Contact</h2>
      <p style="color: var(--text-secondary); line-height: 1.7;">
        Questions regarding these Terms may be directed to <a href="mailto:spinthewheelsonline@gmail.com">spinthewheelsonline@gmail.com</a>.
      </p>
    </article>
  </main>
  <WheelModals lang={lang} t={t} chrome={uiChrome} />
  <CookieBanner lang={lang} chrome={uiChrome} />
  <SiteFooter lang={lang} chrome={uiChrome} currentPath="/terms-and-conditions" />
  <script src={ASSETS.jsHref} defer></script>
</body>
</html>

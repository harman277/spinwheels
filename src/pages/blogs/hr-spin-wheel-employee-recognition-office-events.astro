    <!-- Structured Data: single consolidated @graph -->
    <script type="application/ld+json" set:html={"{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Organization\",\n      \"@id\": \"https://spinthewheelsonline.com/#organization\",\n      \"name\": \"Spin The Wheels Online\",\n      \"url\": \"https://spinthewheelsonline.com\",\n      \"logo\": {\n        \"@type\": \"ImageObject\",\n        \"url\": \"https://spinthewheelsonline.com/logo-512x512.png\",\n        \"width\": 512,\n        \"height\": 512\n      },\n      \"contactPoint\": {\n        \"@type\": \"ContactPoint\",\n        \"contactType\": \"customer support\",\n        \"email\": \"spinthewheelsonline@gmail.com\",\n        \"url\": \"https://spinthewheelsonline.com/contact\"\n      }\n    },\n    {\n      \"@type\": \"Person\",\n      \"@id\": \"https://spinthewheelsonline.com/#harman\",\n      \"name\": \"Harman S.\",\n      \"jobTitle\": \"Founder & Lead Engineer\",\n      \"url\": \"https://spinthewheelsonline.com/about\",\n      \"worksFor\": {\n        \"@id\": \"https://spinthewheelsonline.com/#organization\"\n      }\n    },\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"https://spinthewheelsonline.com/#website\",\n      \"name\": \"Spin The Wheels Online\",\n      \"url\": \"https://spinthewheelsonline.com\",\n      \"publisher\": {\n        \"@id\": \"https://spinthewheelsonline.com/#organization\"\n      }\n    },\n    {\n      \"@type\": \"WebPage\",\n      \"@id\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events#webpage\",\n      \"url\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events\",\n      \"name\": \"HR Spin Wheels for Employee Recognition & Events\",\n      \"inLanguage\": \"en\",\n      \"isPartOf\": {\n        \"@id\": \"https://spinthewheelsonline.com/#website\"\n      },\n      \"publisher\": {\n        \"@id\": \"https://spinthewheelsonline.com/#organization\"\n      },\n      \"breadcrumb\": {\n        \"@id\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events#breadcrumbs\"\n      }\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"@id\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events#breadcrumbs\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"Home\",\n          \"item\": \"https://spinthewheelsonline.com/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"Blog\",\n          \"item\": \"https://spinthewheelsonline.com/blogs\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 3,\n          \"name\": \"HR Spin Wheel: Employee Recognition & Office Events\",\n          \"item\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events\"\n        }\n      ]\n    },\n    {\n      \"@type\": \"BlogPosting\",\n      \"@id\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events#article\",\n      \"headline\": \"How HR Teams Use Spin Wheels for Employee Recognition & Office Events\",\n      \"description\": \"How HR teams use a free spin wheel for employee recognition, office events, onboarding icebreakers, and fair resource allocation.\",\n      \"image\": \"https://spinthewheelsonline.com/eng-team-picker-wheel.webp\",\n      \"datePublished\": \"2026-11-21\",\n      \"dateModified\": \"2026-11-24\",\n      \"inLanguage\": \"en\",\n      \"author\": {\n        \"@id\": \"https://spinthewheelsonline.com/#harman\"\n      },\n      \"publisher\": {\n        \"@id\": \"https://spinthewheelsonline.com/#organization\"\n      },\n      \"mainEntityOfPage\": {\n        \"@id\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events#webpage\"\n      }\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"@id\": \"https://spinthewheelsonline.com/blogs/hr-spin-wheel-employee-recognition-office-events#faq\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can the same wheel be reused across multiple teams or departments?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes. Each wheel saves as a shareable link, so any manager or HR partner can duplicate it and swap in their own team's names, keeping every department's draw independent and self-serve.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Is the spin result genuinely random or can it be influenced?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"The outcome is generated before the spin animation plays using the browser's Web Cryptography API (window.crypto.getRandomValues) with rejection sampling, so click timing has no effect on the result. The spin itself is a visual reveal of an outcome that was already decided.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What if the winner isn't present when the wheel is spun?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Capture the result with a screenshot and carry the announcement forward. The live draw is what matters for transparency; the timing of the formal presentation to the winner is a separate, secondary step.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Does a random draw undermine genuine recognition?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"A spin wheel works best as one part of a broader recognition programme, not a replacement for personal acknowledgement. It fairly decides who receives a reward in a given cycle, while managers should still follow up with specific, individual praise.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can prizes or activities be added instead of names?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, any text can go on a wheel entry. Many HR teams run a two-stage draw: one spin picks the winner's name, a second spin picks their prize from a separate wheel.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How does this work for hybrid or fully remote teams?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Screen-share the wheel on a video call with system audio enabled so remote staff hear the same ticking sound and see the same live spin as people in the office.\"\n          }\n        }\n      ]\n    }\n  ]\n}"} />


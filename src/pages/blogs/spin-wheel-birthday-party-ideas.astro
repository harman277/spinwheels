    <style is:inline>:root{--pink:#ec4899;--pink-dark:#be185d;--purple:#7c3aed;--gold:#f59e0b;--dark:#111827;--text:#1f2937;--muted:#6b7280;--bg:#fdf8ff;--border:#e5e7eb;--card:#fff;--sidebar:#f5f0ff;--green:#16a34a;--blue:#2563eb;--teal:#0d9488;--red:#e8391b}*,::after,::before{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{font-family:Lora,Georgia,serif;background:var(--bg);color:var(--text);line-height:1.85;font-size:16px;overflow-x:hidden}img{max-width:100%;height:auto;display:block;border-radius:12px}a{color:var(--pink);text-decoration:none}a:hover{text-decoration:underline}#read-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--pink),var(--purple));z-index:9999;width:0%;transition:width .1s}#back-top{position:fixed;bottom:clamp(16px,3vw,28px);right:clamp(16px,3vw,28px);width:clamp(38px,5vw,46px);height:clamp(38px,5vw,46px);border-radius:50%;background:var(--pink);color:#fff;border:none;cursor:pointer;font-size:clamp(16px, 2.5vw, 20px);display:none;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(236,72,153,.4);transition:transform .2s;z-index:100}#back-top.show{display:flex}#back-top:hover{transform:translateY(-3px)}.topbar{background:var(--dark);color:#9ca3af;font-family:"DM Sans",sans-serif;font-size:clamp(11px, 1.5vw, 12.5px);text-align:center;padding:7px 16px;letter-spacing:.03em;line-height:1.6}.topbar a{color:var(--gold);font-weight:600}.topbar a:hover{color:#fff;text-decoration:none}.breadcrumb-bar{background:#fff;border-bottom:1px solid var(--border)}.bc-inner{max-width:1240px;margin:0 auto;padding:9px clamp(14px,4vw,24px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:var(--muted);display:flex;align-items:center;flex-wrap:wrap;gap:2px}.bc-inner a{color:var(--pink)}.bc-sep{margin:0 5px;color:#d1d5db}.post-hero{background:linear-gradient(135deg,#1a0020 0,#3b0764 40%,#1a000f 100%);color:#fff;padding:clamp(36px,7vw,64px) clamp(16px,5vw,24px) clamp(32px,6vw,52px);text-align:center;position:relative;overflow:hidden}.post-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 20% 50%,rgba(236,72,153,.25),transparent 55%),radial-gradient(ellipse at 80% 30%,rgba(124,58,237,.2),transparent 50%)}.hero-floats{position:absolute;inset:0;pointer-events:none;overflow:hidden}.hero-floats span{position:absolute;font-size:clamp(16px, 2.5vw, 28px);animation:floatUp 9s infinite ease-in-out;opacity:.14}.hero-floats span:first-child{left:4%;top:20%;animation-delay:0s}.hero-floats span:nth-child(2){left:13%;top:71%;animation-delay:1.4s}.hero-floats span:nth-child(3){left:88%;top:15%;animation-delay:.6s}.hero-floats span:nth-child(4){left:77%;top:74%;animation-delay:2.2s}.hero-floats span:nth-child(5){left:52%;top:84%;animation-delay:3.1s}.hero-floats span:nth-child(6){left:93%;top:46%;animation-delay:1.9s}.hero-floats span:nth-child(7){left:34%;top:9%;animation-delay:.9s}.hero-floats span:nth-child(8){left:64%;top:30%;animation-delay:2.5s}@keyframes floatUp{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-16px) rotate(4deg)}}@keyframes spin-slow{to{transform:rotate(360deg)}}.hero-tag{display:inline-block;background:var(--pink);color:#fff;font-family:"DM Sans",sans-serif;font-size:clamp(10px, 1.3vw, 11.5px);font-weight:700;text-transform:uppercase;letter-spacing:.12em;padding:5px clamp(12px,2vw,16px);border-radius:20px;margin-bottom:clamp(12px,2.5vw,20px);position:relative}.post-hero h1{font-family:"Playfair Display",serif;font-size:clamp(22px, 5vw, 48px);font-weight:900;max-width:920px;margin:0 auto clamp(12px,2.5vw,18px);line-height:1.16;position:relative}.post-hero h1 em{color:var(--gold);font-style:normal}.hero-sub{font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2.2vw, 17px);color:rgba(255,255,255,.72);max-width:700px;margin:0 auto clamp(18px,3vw,28px);position:relative}.post-meta{display:flex;align-items:center;justify-content:center;gap:clamp(8px,2vw,18px);font-family:"DM Sans",sans-serif;font-size:clamp(11.5px, 1.5vw, 13px);color:rgba(255,255,255,.55);flex-wrap:wrap;position:relative}.meta-dot{color:rgba(255,255,255,.25)}.updated-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.3);color:var(--gold);font-family:"DM Sans",sans-serif;font-size:clamp(11px, 1.4vw, 12px);font-weight:600;padding:5px 13px;border-radius:20px;margin-top:clamp(10px,2vw,16px);position:relative}.layout{max-width:1240px;margin:0 auto;padding:clamp(20px,4vw,40px) clamp(14px,4vw,24px) clamp(40px,6vw,60px);display:grid;grid-template-columns:1fr 330px;gap:clamp(24px,4vw,44px);align-items:start}article{background:var(--card);border-radius:14px;padding:clamp(20px,5vw,44px) clamp(18px,5vw,48px);box-shadow:0 1px 4px rgba(0,0,0,.06);min-width:0}.toc{background:#fdf4ff;border:1px solid #e9d5ff;border-left:4px solid var(--pink);border-radius:0 12px 12px 0;padding:clamp(14px,3vw,22px) clamp(16px,3vw,26px);margin-bottom:clamp(24px,4vw,38px)}.toc-title{font-family:"DM Sans",sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:14px;font-weight:600}.toc ol{padding-left:18px;display:flex;flex-direction:column;gap:7px}.toc li{font-family:"DM Sans",sans-serif;font-size:clamp(13px, 1.6vw, 14px)}.toc a{color:var(--pink);transition:color .15s}.toc a:hover{color:var(--pink-dark)}article h2{font-family:"Playfair Display",serif;font-size:clamp(20px, 3.5vw, 26px);font-weight:800;color:var(--dark);margin:clamp(28px,5vw,44px) 0 clamp(10px,2vw,16px);padding-bottom:10px;border-bottom:2px solid #f3e8ff;scroll-margin-top:20px;line-height:1.25}article h3{font-family:"DM Sans",sans-serif;font-size:clamp(16px, 2.5vw, 19px);font-weight:700;color:var(--dark);margin:clamp(18px,3vw,28px) 0 10px}article p{margin-bottom:18px;color:#2d3748;font-size:clamp(15px, 2vw, 16.5px)}article ol,article ul{padding-left:clamp(16px,3vw,22px);margin-bottom:18px;display:flex;flex-direction:column;gap:9px}article li{font-size:clamp(14.5px, 2vw, 16px);color:#2d3748;line-height:1.75}article strong{color:var(--dark)}.ilink{color:var(--pink);font-weight:600;border-bottom:1px dashed rgba(236,72,153,.5);transition:border-color .2s}.ilink:hover{border-bottom-style:solid;text-decoration:none}figure.ai-image{margin:30px 0}figure.ai-image figcaption{font-family:"DM Sans",sans-serif;font-size:12.5px;color:var(--muted);margin-top:8px;text-align:center}.step-list{list-style:none!important;padding:0!important;counter-reset:steps}.step-list li{counter-increment:steps;display:flex;gap:clamp(12px,2.5vw,16px);padding:clamp(14px,2.5vw,20px) 0;border-bottom:1px solid #f3e8ff}.step-list li:last-child{border:none}.step-num{width:clamp(32px,4.5vw,42px);height:clamp(32px,4.5vw,42px);background:var(--pink);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:"DM Sans",sans-serif;font-weight:700;font-size:clamp(13px, 1.8vw, 16px);flex-shrink:0;margin-top:2px}.step-num::before{content:counter(steps)}.step-body strong{display:block;font-family:"DM Sans",sans-serif;font-size:clamp(14px, 2vw, 16px);font-weight:700;margin-bottom:6px;color:var(--dark)}.step-body p{font-size:clamp(13px, 1.8vw, 14.5px);color:#4b5563;margin:0}.step-body ul{font-size:clamp(13px, 1.8vw, 14.5px);color:#4b5563;margin-top:8px}.idea-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:28px 0}.idea-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:clamp(14px,2.5vw,20px);transition:transform .2s,box-shadow .2s;border-top:3px solid var(--pink)}.idea-card.purple{border-top-color:var(--purple)}.idea-card.teal{border-top-color:var(--teal)}.idea-card.gold{border-top-color:var(--gold)}.idea-card:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(0,0,0,.09)}.idea-num{font-family:"DM Sans",sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--p
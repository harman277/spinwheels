    <style is:inline>*,::after,::before{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth;font-size:16px}:root{--cream:#faf8f4;--warm-white:#f5f2ec;--ink:#1a1714;--ink-soft:#3d3830;--ink-muted:#7a7060;--rule:#e8e2d9;--accent:#d4500a;--accent-lt:#f4e4d8;--accent2:#2e6b52;--accent2-lt:#d8ede6;--accent3:#4a3080;--accent3-lt:#e8e2f5;--yellow:#f0c14b;--yellow-lt:#fdf6dc;--font-head:"Playfair Display",Georgia,serif;--font-body:"DM Sans",system-ui,sans-serif;--font-mono:"DM Mono",monospace;--max-w:780px;--max-w-wide:1100px;--radius:10px;--shadow-sm:0 2px 8px rgba(26, 23, 20, 0.07);--shadow-md:0 6px 24px rgba(26, 23, 20, 0.1)}body{font-family:var(--font-body);background:var(--cream);color:var(--ink);line-height:1.72;font-weight:400;-webkit-font-smoothing:antialiased}img{max-width:100%;display:block;border-radius:var(--radius)}.breadcrumb{max-width:var(--max-w-wide);margin:0 auto;padding:14px 24px 0;font-size:.8rem;color:var(--ink-muted);display:flex;align-items:center;gap:6px;flex-wrap:wrap}.breadcrumb a{color:var(--ink-muted);text-decoration:none}.breadcrumb a:hover{color:var(--accent);text-decoration:underline}.breadcrumb span{opacity:.5}.article-wrap{max-width:var(--max-w-wide);margin:0 auto;padding:0 24px 80px;display:grid;grid-template-columns:1fr 240px;grid-template-areas:"header header" "body sidebar";gap:0 48px;align-items:start}@media (max-width:960px){.article-wrap{grid-template-columns:1fr;grid-template-areas:"header" "body"}}.article-header{grid-area:header;padding:40px 0 36px;border-bottom:1.5px solid var(--rule);margin-bottom:44px}.article-tag{display:inline-flex;align-items:center;gap:6px;background:var(--accent-lt);color:var(--accent);font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:5px 12px;border-radius:100px;margin-bottom:20px}.article-title{font-family:var(--font-head);font-size:clamp(1.9rem, 4vw, 2.9rem);font-weight:900;line-height:1.18;color:var(--ink);margin-bottom:18px;max-width:720px}.article-
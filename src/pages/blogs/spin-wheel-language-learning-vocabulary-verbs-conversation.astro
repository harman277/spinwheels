-a a:hover{border-color:var(--accent)}.takeaways{background:var(--accent-lt);border:1.5px solid #e8c8b0;border-radius:var(--radius);padding:24px 26px;margin:40px 0}.takeaways h3,.takeaways h4{font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}.takeaways ul{padding-left:20px}.takeaways li{font-size:.92rem;color:var(--ink-soft);margin-bottom:.6em}.takeaways li strong{color:var(--ink)}.all-articles{margin:40px 0 0}.all-articles h3{font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-muted);margin-bottom:16px;padding-bottom:10px;border-bottom:1.5px solid var(--rule)}.article-list{list-style:none}.article-list li{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 0;border-bottom:1px solid var(--rule);font-size:.88rem}.article-list li:last-child{border-bottom:none}.article-list li span{color:var(--ink-muted);font-size:.76rem;white-space:nowrap;flex-shrink:0}.article-list a{color:var(--ink-soft);text-decoration:none;font-weight:500}.article-list a:hover{color:var(--accent)}.share-row{display:flex;align-items:center;gap:12px;margin:40px 0 32px;flex-wrap:wrap}.share-label{font-size:.82rem;font-weight:600;color:var(--ink-muted)}.share-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:100px;font-size:.8rem;font-weight:600;text-decoration:none;border:1.5px solid var(--rule);color:var(--ink-soft);background:var(--warm-white);cursor:pointer;transition:border-color .2s,color .2s}.share-btn:hover{border-color:var(--accent);color:var(--accent)}#scrollTop{position:fixed;bottom:24px;right:24px;background:var(--ink);color:#fff;border:none;width:42px;height:42px;border-radius:50%;cursor:pointer;font-size:1.1rem;display:flex;align-items:center;justify-content:center;opacity:0;transform:translateY(12px);transition:opacity .3s,transform .3s;box-shadow:var(--shadow-md);z-index:50}#scrollTop.visible{opacity:1;transform:translateY(0)}#scrollTop:hover{background:var(--accent)}#readingProgress{position:fixed;top:0;left:0;height:3px;background:var(--accent);width:0%;z-index:200;transition:width .1s linear}.section-divider{border:none;border-top:1.5px solid var(--rule);margin:48px 0}.emoji-header{font-size:1.4rem;margin-right:6px}@media (max-width:400px){.article-wrap{padding:0 16px 60px}.breadcrumb{padding:12px 16px 0}.cta-banner{padding:28px 20px}}</style>

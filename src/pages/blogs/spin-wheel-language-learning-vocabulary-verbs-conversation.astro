rem;color:var(--ink-muted);margin:0 0 12px;line-height:1.55}.idea-wheel-label{font-size:.76rem;font-weight:600;color:var(--ink-soft);display:block;margin-bottom:4px}.idea-entries{display:flex;flex-wrap:wrap;gap:6px}.entry-tag{font-size:.72rem;background:var(--rule);color:var(--ink-soft);padding:3px 9px;border-radius:100px;font-family:var(--font-mono)}.subject-section{margin:28px 0}.subject-card{border:1.5px solid var(--rule);border-radius:var(--radius);overflow:hidden;margin-bottom:10px;transition:box-shadow .2s}.subject-card:hover{box-shadow:var(--shadow-sm)}.subject-toggle{width:100%;background:var(--warm-white);border:none;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-family:var(--font-body);font-size:.96rem;font-weight:600;color:var(--ink);text-align:left;gap:12px}.subject-toggle .s-icon{font-size:1.1rem;flex-shrink:0}.subject-toggle .s-arrow{transition:transform .25s;color:var(--ink-muted);flex-shrink:0}.subject-toggle.open .s-arrow{transform:rotate(180deg)}.subject-body{display:none;padding:6px 20px 20px;font-size:.9rem;color:var(--ink-soft);background:var(--cream);line-height:1.65}.subject-body.open{display:block}.subject-body ul{padding-left:20px;margin-top:10px}.subject-body li{margin-bottom:.5em}.subject-body strong{color:var(--ink)}.wheel-sample{background:var(--warm-white);border:1.5px dashed var(--rule);border-radius:8px;padding:12px 16px;margin-top:12px;font-size:.82rem}.wheel-sample strong{display:block;margin-bottom:6px;font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-muted)}.cta-banner{background:var(--ink);color:#fff;border-radius:14px;padding:36px 32px;text-align:center;margin:48px 0;position:relative;overflow:hidden}.cta-banner::before{content:"🎡";position:absolute;font-size:9rem;opacity:.06;right:-20px;top:-20px;pointer-events:none}.cta-banner h3{font-family:var(--font-head);font-size:1.5rem;margin-bottom:10px;color:#fff}.cta-banner p{color:#c4bdb0;font-size:.92r
    <meta
      property="og:title"
      content="Spin Wheel Weekly Planner: Meals, Workouts &amp; Tasks"
    />
    <meta
      property="og:description"
      content="Five free spin wheels that plan your entire week — meals, workouts, tasks, self-care, and weekends — without the daily decision fatigue."

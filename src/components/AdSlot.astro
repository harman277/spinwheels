---
import { ADS_CONFIG, type AdSlotKey } from "../config/ads";

interface Props {
  slot: AdSlotKey;
  enabled?: boolean;
}

const { slot, enabled = true } = Astro.props;
const cfg = ADS_CONFIG.slots[slot];
const shouldRender = Boolean(enabled && ADS_CONFIG.enableManualSlots && cfg && cfg.id);
---

{shouldRender && (
  <aside
    class={`stwol-ad-slot stwol-ad-${slot}`}
    aria-label="Advertisement"
    style={`--ad-min-h-d:${cfg.minHeightDesktop}px; --ad-min-h-m:${cfg.minHeightMobile}px;`}
  >
    <span class="stwol-ad-label">Advertisement</span>
    <ins
      class="adsbygoogle"
      style="display:block; width:100%;"
      data-ad-client={ADS_CONFIG.publisherId}
      data-ad-slot={cfg.id}
      data-ad-format={cfg.format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
    </script>
  </aside>
)}

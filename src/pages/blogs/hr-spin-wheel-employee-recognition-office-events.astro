    <style is:inline>*,::after,::before{box-sizing:border-box;margin:0;padding:0}:root{--brand:#6c3fff;--brand-dark:#5530d6;--brand-light:#ede8ff;--green:#16a34a;--green-bg:#dcfce7;--yellow:#ca8a04;--yellow-bg:#fef9c3;--blue:#2563eb;--blue-bg:#dbeafe;--text:#1a1a2e;--muted:#64748b;--border:#e2e8f0;--bg:#fff;--bg-soft:#f8f7ff;--bg-card:#fafaff;--radius:12px;--radius-sm:8px;--shadow:0 2px 12px rgba(108, 63, 255, 0.08);--shadow-md:0 4px 24px rgba(108, 63, 255, 0.13)}html{scroll-behavior:smooth}body{font-family:Georgia,"Times New Roman",serif;font-size:17px;line-height:1.78;color:var(--text);background:var(--bg)}a{color:var(--brand);text-decoration:none}a:hover{text-decoration:underline}.breadcrumb{max-width:1160px;margin:0 auto;padding:12px 20px;font-family:system-ui,sans-serif;font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px;align-items:center}.breadcrumb a{color:var(--muted)}.breadcrumb a:hover{color:var(--brand)}.page-wrap{max-width:1160px;margin:0 auto;padding:0 20px 60px;display:grid;grid-template-columns:1fr 260px;gap:48px;align-items:start}article{min-width:0}.emoji-strip{font-size:28px;letter-spacing:4px;margin-bottom:16px}.cat-badge{display:inline-flex;align-items:center;gap:6px;font-family:system-ui,sans-serif;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--brand);background:var(--brand-light);padding:4px 10px;border-radius:20px;margin-bottom:16px}h1{font-family:system-ui,sans-serif;font-size:clamp(26px, 5vw, 40px);font-weight:900;line-height:1.18;color:var(--text);margin-bottom:16px}h1 em{font-style:normal;color:var(--brand)}.article-meta{font-family:system-ui,sans-serif;font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--border)}.lead{font-size:18px;line-height:1.7;color:#374151;margin-bottom:32px}.hero-image{border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);margin-bottom:32px}.hero-image img{width:100%;height:auto;display:block}.article-image{border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);margin:28px 0}.article-image img{width:100%;height:auto;display:block}.article-image figcaption{font-family:system-ui,sans-serif;font-size:12.5px;color:var(--muted);padding:10px 16px;background:var(--bg-soft)}.toc{background:var(--bg-soft);border:1px solid var(--border);border-left:4px solid var(--brand);border-radius:var(--radius);padding:20px 24px;margin-bottom:40px}.toc h2{font-family:system-ui,sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:12px}.toc ol{padding-left:20px;display:flex;flex-direction:column;gap:6px}.toc ol li{font-family:system-ui,sans-serif;font-size:14px}.toc ol a{color:var(--brand);font-weight:500}h2{font-family:system-ui,sans-serif;font-size:clamp(20px, 3.5vw, 27px);font-weight:800;color:var(--text);margin:48px 0 16px;padding-top:8px}h3{font-family:system-ui,sans-serif;font-size:18px;font-weight:700;color:var(--text);margin:32px 0 12px}p{margin-bottom:20px}p:last-child{margin-bottom:0}ol,ul{padding-left:24px;margin-bottom:20px;display:flex;flex-direction:column;gap:8px}li{line-height:1.65}.callout{border-radius:var(--radius);padding:18px 22px;margin:32px 0;font-family:system-ui,sans-serif;font-size:14.5px;line-height:1.65}.callout-icon{font-size:20px;margin-bottom:8px}.callout strong{display:block;font-size:15px;margin-bottom:6px}.callout.blue{background:var(--blue-bg);border-left:4px solid var(--blue);color:#1e3a8a}.callout.green{background:var(--green-bg);border-left:4px solid var(--green);color:#14532d}.callout.yellow{background:var(--yellow-bg);border-left:4px solid var(--yellow);color:#713f12}.callout.purple{background:var(--brand-light);border-left:4px solid var(--brand);color:#3b0764}.stat-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:32px 0}.stat-card{background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);padding:20px 16px;text-align:center}.stat-card .num{font-family:system-ui,sans-serif;font-size:clamp(22px, 4vw, 32px);font-weight:900;color:var(--brand);display:block;margin-bottom:6px}.stat-card .label{font-family:system-ui,sans-serif;font-size:12px;color:var(--muted);line-height:1.4}.cards-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:24px 0}.feature-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px}.feature-card .card-num{font-family:system-ui,sans-serif;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px}.feature-card .card-icon{font-size:24px;margin-bottom:10px}.feature-card h3,.feature-card h4{font-family:system-ui,sans-serif;font-size:15px;font-weight:700;color:var(--text);margin-bottom:8px}.feature-card p{font-family:system-ui,sans-serif;font-size:13.5px;color:var(--muted);line-height:1.6;margin:0}.use-case{border:1px solid var(--border);border-radius:var(--radius);margin:20px 0;overflow:hidden}.use-case-header{background:var(--bg-soft);padding:14px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}.use-case-header .uc-icon{font-size:22px}.use-case-header h3{font-family:system-ui,sans-serif;font-size:16px;font-weight:700;color:var(--text);margin:0}.use-case-header .uc-tag{margin-left:auto;font-family:system-ui,sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--brand);background:var(--brand-light);padding:3px 8px;border-radius:10px;white-space:nowrap}.use-case-body{padding:18px 20px;font-family:system-ui,sans-serif;font-size:14.5px;line-height:1.65;color:#374151}.use-case-body p{margin-bottom:10px;font-family:system-ui,sans-serif;font-size:14.5px}.wheel-entries{background:#f1f5f9;border-radius:var(--radius-sm);padding:12px 14px;margin-top:10px}.wheel-entries strong{font-family:system-ui,sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);display:block;margin-bottom:6px}.wheel-entries ul{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0;list-style:none}.wheel-entries ul li{background:#fff;border:1px solid var(--border);border-radius:6px;padding:3px 10px;font-size:13px;color:var(--text);font-family:system-ui,sans-serif}.table-wrap{overflow-x:auto;margin:28px 0;border-radius:var(--radius);border:1px solid var(--border)}table{width:100%;border-collapse:collapse;font-family:system-ui,sans-serif;font-size:14px}thead tr{background:var(--bg-soft)}th{text-align:left;padding:12px 16px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);border-bottom:1px solid var(--border);white-space:nowrap}td{padding:12px 16px;border-bottom:1px solid var(--border);line-height:1.5;vertical-align:top}tr:last-child td{border-bottom:none}tr:nth-child(2n) td{background:#fafafa}.check{color:var(--green);font-weight:700}.related-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:28px 0}.related-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;transition:box-shadow .2s,border-color .2s;display:flex;flex-direction:column;gap:6px}.related-card:hover{box-shadow:var(--shadow-md);border-color:var(--brand);text-decoration:none}.related-card .rc-badge{font-family:system-ui,sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.related-card h3,.related-card h4{font-family:system-ui,sans-serif;font-size:14px;font-weight:700;color:var(--text);line-height:1.4}.related-card .rc-meta{font-family:system-ui,sans-serif;font-size:12px;color:var(--muted)}.related-card .rc-arrow{font-family:system-ui,sans-serif;font-size:12px;color:var(--brand);font-weight:600;margin-top:auto}.cta-block{background:linear-gradient(135deg,var(--brand) 0,var(--brand-dark) 100%);color:#fff;border-radius:var(--radius);padding:32px;text-align:center;margin:40p
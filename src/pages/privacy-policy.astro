---
import { LANGUAGES, TRANSLATIONS } from "../data/i18n.js";
import { getChrome } from "../data/i18n-chrome.js";
import { SITE_URL, SITE_NAME, REVIEWED_ISO, ASSETS } from "../config/site";
import AnalyticsHead from "../components/AnalyticsHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WheelModals from "../components/WheelModals.astro";
import CookieBanner from "../components/CookieBanner.astro";

const lang = (LANGUAGES as any).en;
const t = (TRANSLATIONS as any).en;
const uiChrome = getChrome("en");

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: SITE_NAME, url: SITE_URL, logo: { "@type": "ImageObject", url: `${SITE_URL}/logo-512x512.png`, width: 512, height: 512 }, contactPoint: { "@type": "ContactPoint", contactType: "customer support", email: "spinthewheelsonline@gmail.com", url: `${SITE_URL}/contact` } },
    { "@type": "WebSite", "@id": `${SITE_URL}/#website`, name: SITE_NAME, url: SITE_URL, publisher: { "@id": `${SITE_URL}/#organization` } },
    { "@type": "WebPage", "@id": `${SITE_URL}/privacy-policy#webpage`, name: "Privacy Policy", url: `${SITE_URL}/privacy-policy`, description: "Privacy policy and regulatory compliance disclosures for Spin The Wheels Online.", dateModified: REVIEWED_ISO, inLanguage: "en", isPartOf: { "@id": `${SITE_URL}/#website` }, publisher: { "@id": `${SITE_URL}/#organization` }, breadcrumb: { "@id": `${SITE_URL}/privacy-policy#breadcrumbs` } },
    { "@type": "BreadcrumbList", "@id": `${SITE_URL}/privacy-policy#breadcrumbs`, itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` }, { "@type": "ListItem", position: 2, name: "Privacy Policy", item: `${SITE_URL}/privacy-policy` }] }
  ]
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Privacy Policy – Spin The Wheels Online</title>
  <meta name="description" content="Privacy Policy for Spin The Wheels Online: details on browser-local wheel storage, cookies, Google AdSense, GDPR, CCPA rights, and opt-out controls." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={`${SITE_URL}/privacy-policy`} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#F59E0B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" /></noscript>
  <link rel="stylesheet" href={ASSETS.cssHref} />
  <AnalyticsHead enableAds={false} />
  <script type="application/ld+json" set:html={schemaJson} />
</head>
<body>
  <SiteHeader lang={lang} t={t} chrome={uiChrome} currentPath="/privacy-policy" />
  <main class="container" style="max-width: 860px; padding: 48px 20px;">
    <article class="card" style="padding: clamp(24px, 5vw, 44px);">
      <h1 class="section-title" style="text-align: left; margin-bottom: 8px;">Privacy <span>Policy</span></h1>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 24px;">Effective Date: January 1, 2025 · Last Updated: November 24, 2026</p>
      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 20px;">
        At <strong>Spin The Wheels Online</strong> ("we", "us", or "our"), accessible from <strong>https://spinthewheelsonline.com</strong>, we are committed to safeguarding your privacy worldwide. This Privacy Policy outlines what limited data is processed and your rights under GDPR, the UK Data Protection Act, and CCPA/CPRA.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">1. Data We Do NOT Collect (Client-Side Isolation)</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        <strong>Your custom wheel entries (student names, private choices, raffle lists, or custom text) stay strictly inside your local browser memory and LocalStorage.</strong> Entries are never sent to our servers, never stored in remote databases, and never sold to third parties.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">2. Log Files &amp; Technical Analytics</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        Standard edge CDN logs and aggregated analytics may record browser type, device category, referring pages, and timestamps to keep pages fast and reliable across mobile and desktop screens.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">3. Google Analytics &amp; Consent Mode v2</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        We use Google Analytics 4 (GA4) with Google Consent Mode v2 to measure high-level traffic and page performance. You can choose "Accept All" or "Reject Non-Essential" via our cookie consent banner at any time.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">4. Google AdSense &amp; Advertising Disclosures</h2>
      <ul style="margin: 0 0 16px 24px; color: var(--text-secondary); line-height: 1.7;">
        <li>Third-party vendors, including Google, use cookies to serve ads based on prior visits to our website or other websites across the Internet.</li>
        <li>Google's use of advertising cookies enables it and its partners to serve ads to users based on their visits to our site and/or other sites on the Internet.</li>
        <li>You may opt out of personalized advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ads Settings</a> or <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener">aboutads.info</a>.</li>
      </ul>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">5. GDPR, CCPA &amp; COPPA Rights</h2>
      <p style="color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px;">
        EEA, UK, and California residents may request access, correction, restriction, or deletion of any personal correspondence submitted through our contact desk. We do not sell personal information and do not knowingly collect personal information from children under 13.
      </p>
      <h2 style="font-size: 1.25rem; font-weight: 800; margin: 28px 0 10px; color: var(--text-primary);">6. Contact</h2>
      <p style="color: var(--text-secondary); line-height: 1.7;">
        <strong>Email:</strong> <a href="mailto:spinthewheelsonline@gmail.com">spinthewheelsonline@gmail.com</a><br />
        <strong>Website:</strong> <a href="https://spinthewheelsonline.com">https://spinthewheelsonline.com</a>
      </p>
    </article>
  </main>
  <WheelModals lang={lang} t={t} chrome={uiChrome} />
  <CookieBanner lang={lang} chrome={uiChrome} />
  <SiteFooter lang={lang} chrome={uiChrome} currentPath="/privacy-policy" />
  <script src={ASSETS.jsHref} defer></script>
</body>
</html>

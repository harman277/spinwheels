---
import { LANGUAGES, TRANSLATIONS } from "../data/i18n.js";
import { getChrome } from "../data/i18n-chrome.js";
import SPECIALIZED_WHEELS from "../data/specialized-wheels.js";
import { CATEGORIES, CATEGORIES_BY_SLUG, CATEGORY_NAME_TO_SLUG } from "../data/categories.js";
import {
  SITE_URL,
  SITE_NAME,
  REVIEWED_ISO,
  REVIEWED_TEXT,
  INDEXABLE_LANGS,
  FEATURED_HOME_SLUGS,
  FEATURED_HOME_BLOGS,
  ASSETS,
  toHreflangCode
} from "../config/site";
import AnalyticsHead from "./AnalyticsHead.astro";
import AdSlot from "./AdSlot.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import WheelModals from "./WheelModals.astro";
import CookieBanner from "./CookieBanner.astro";

interface Props {
  langCode?: string;
  slug?: string;
}

const { langCode = "en", slug = "" } = Astro.props;

const langMeta = (LANGUAGES as any)[langCode] || (LANGUAGES as any).en;
const baseT = (TRANSLATIONS as any)[langCode] || (TRANSLATIONS as any).en;
const uiChrome = getChrome(langCode);
const tool = slug ? (SPECIALIZED_WHEELS as any)[slug] : null;
const isRtl = langCode === "ar" || langCode === "he";
const htmlLangAttr = toHreflangCode(langCode);

// Build merged translation object (exact parity with Express renderToolWheel)
const customT = JSON.parse(JSON.stringify(baseT));
const rawLoc = tool?.translations?.[langCode] || null;
const hasNativeToolLoc = Boolean(
  slug && langCode !== "en" && INDEXABLE_LANGS.has(langCode) && rawLoc && rawLoc.name && rawLoc.heroSubtitle && rawLoc.items
);

let isIndexed = false;

if (!slug) {
  isIndexed = INDEXABLE_LANGS.has(langCode);
} else if (langCode === "en" && tool) {
  isIndexed = true;
  customT.metaTitle = tool.title;
  customT.metaDesc = tool.description;
  if (tool.keywords) customT.keywords = tool.keywords;
  customT.heroTitle = tool.heroTitle;
  customT.heroHighlight = tool.heroHighlight;
  customT.heroSubtitle = tool.heroSubtitle;
  customT.quickAnswer = tool.quickAnswer;
  if (tool.howTo) customT.howTo = tool.howTo;
  if (tool.useCases) customT.useCases = tool.useCases;
  if (tool.presets) customT.presets = tool.presets;
  if (tool.faqs && tool.faqs.length) {
    customT.faqs = tool.faqs.length >= 4 ? tool.faqs.slice() : tool.faqs.concat(baseT.faqs.slice(0, 3));
  }
  if (Array.isArray(tool.extraFaqs) && tool.extraFaqs.length) {
    const seenQ = new Set((customT.faqs || []).map((f: any) => f.q));
    tool.extraFaqs.forEach((f: any) => {
      if (f && f.q && !seenQ.has(f.q)) {
        seenQ.add(f.q);
        customT.faqs.push(f);
      }
    });
  }
} else if (hasNativeToolLoc && rawLoc) {
  isIndexed = true;
  customT.metaTitle = rawLoc.title || `${rawLoc.name} – ${baseT.metaTitle}`;
  customT.metaDesc = rawLoc.description || baseT.metaDesc;
  if (rawLoc.keywords) customT.keywords = rawLoc.keywords;
  customT.heroTitle = rawLoc.heroTitle || rawLoc.name;
  customT.heroHighlight = rawLoc.heroHighlight || rawLoc.name;
  customT.heroSubtitle = rawLoc.heroSubtitle;
  if (rawLoc.quickAnswer) customT.quickAnswer = rawLoc.quickAnswer;
  if (rawLoc.presets) customT.presets = rawLoc.presets;
  if (rawLoc.faqs && rawLoc.faqs.length) {
    customT.faqs = rawLoc.faqs.length >= 4 ? rawLoc.faqs.slice() : rawLoc.faqs.concat(baseT.faqs.slice(0, 3));
  }
} else if (tool) {
  isIndexed = false;
  customT.metaTitle = `${tool.name} – ${baseT.metaTitle}`;
  customT.heroHighlight = tool.name;
}

const toolLoc = hasNativeToolLoc ? rawLoc : null;
const defaultItems = (toolLoc && toolLoc.items) || (tool && tool.items) || null;
const pageRobots = isIndexed
  ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  : "noindex, follow";

const selfPath = slug
  ? langCode === "en" ? `/${slug}` : `/${langCode}/${slug}`
  : langCode === "en" ? "/" : `/${langCode}`;
const selfUrl = `${SITE_URL}${selfPath}`;
const canonicalUrl = selfUrl;
const pageTitle = customT.metaTitle;
const pageDesc = customT.metaDesc;
const bcp47Locale = (langMeta?.locale || "en_US").replace("_", "-");
const ogImg = `${SITE_URL}/${tool?.ogImage || "eng-spin-the-wheel-picker.webp"}`;
const totalWheelsCount = Object.keys(SPECIALIZED_WHEELS).length;
const isLocalizedHub = langCode !== "en" && INDEXABLE_LANGS.has(langCode);
const hasToolDeepGuide = Boolean(langCode === "en" && tool && tool.editorialGuide);

const catSlug = tool ? (CATEGORY_NAME_TO_SLUG as any)[tool.category] : null;
const activeCatObj = catSlug ? (CATEGORIES_BY_SLUG as any)[catSlug] : null;
const localizedCatName = tool?.category ? (uiChrome.categories?.[tool.category] || tool.category) : "";
const localizedWheelName = toolLoc?.name || tool?.name || SITE_NAME;

const altNamesList = Array.isArray(tool?.altNames) && tool.altNames.length
  ? tool.altNames
  : ["Wheel of Names", "Random Wheel Spinner", "Decision Wheel", "Random Name Picker", "Picker Wheel Online"];

const relatedWheels = (tool?.relatedSlugs || [])
  .map((relSlug: string) => ((SPECIALIZED_WHEELS as any)[relSlug] ? { slug: relSlug, ...(SPECIALIZED_WHEELS as any)[relSlug] } : null))
  .filter(Boolean);

const featuredWheels = !slug
  ? FEATURED_HOME_SLUGS.map((s) => ((SPECIALIZED_WHEELS as any)[s] ? { slug: s, ...(SPECIALIZED_WHEELS as any)[s] } : null)).filter(Boolean)
  : [];

const displayBlogs = slug
  ? (langCode === "en" && Array.isArray(tool?.relatedBlogs) ? tool.relatedBlogs : [])
  : (langCode === "en" ? FEATURED_HOME_BLOGS : []);

// Breadcrumbs (4 levels on tool pages)
const breadcrumbItems: Array<Record<string, any>> = [
  { "@type": "ListItem", position: 1, name: uiChrome.homeBreadcrumb || "Home", item: `${SITE_URL}${isLocalizedHub ? `/${langCode}` : "/"}` }
];
if (slug) {
  breadcrumbItems.push({ "@type": "ListItem", position: 2, name: uiChrome.allToolsBreadcrumb || "Tools", item: `${SITE_URL}/tools` });
  if (activeCatObj) {
    const catCrumbName = uiChrome.categories?.[activeCatObj.name] || activeCatObj.name;
    breadcrumbItems.push({ "@type": "ListItem", position: 3, name: catCrumbName, item: `${SITE_URL}/category/${activeCatObj.slug}` });
    breadcrumbItems.push({ "@type": "ListItem", position: 4, name: localizedWheelName, item: selfUrl });
  } else {
    breadcrumbItems.push({ "@type": "ListItem", position: 3, name: localizedWheelName, item: selfUrl });
  }
} else if (langCode !== "en") {
  breadcrumbItems.push({ "@type": "ListItem", position: 2, name: langMeta.name || langCode, item: selfUrl });
}

// Hreflang alternates
const hreflangs: Array<{ hreflang: string; href: string }> = [];
if (isIndexed) {
  const enBase = slug ? `${SITE_URL}/${slug}` : `${SITE_URL}/`;
  hreflangs.push({ hreflang: "x-default", href: enBase });
  hreflangs.push({ hreflang: "en", href: enBase });
  if (slug && tool?.translations) {
    for (const [code, lObj] of Object.entries(tool.translations as Record<string, any>)) {
      if (code !== "en" && INDEXABLE_LANGS.has(code) && lObj && lObj.name && lObj.heroSubtitle && lObj.items) {
        hreflangs.push({ hreflang: toHreflangCode(code), href: `${SITE_URL}/${code}/${slug}` });
      }
    }
  } else if (!slug) {
    for (const code of Object.keys(LANGUAGES)) {
      if (code !== "en" && INDEXABLE_LANGS.has(code)) {
        hreflangs.push({ hreflang: toHreflangCode(code), href: `${SITE_URL}/${code}` });
      }
    }
  }
}

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${selfUrl}#webpage`,
      url: selfUrl,
      name: pageTitle,
      description: pageDesc,
      inLanguage: bcp47Locale,
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@id": `${selfUrl}#webapp` },
      dateModified: REVIEWED_ISO,
      breadcrumb: { "@id": `${selfUrl}#breadcrumbs` },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: [".hero-title", ".hero-subtitle", ".quick-answer-card"]
      }
    },
    {
      "@type": "WebApplication",
      "@id": `${selfUrl}#webapp`,
      name: localizedWheelName,
      alternateName: altNamesList,
      url: selfUrl,
      description: pageDesc,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "All modern browsers (iOS, Android, Windows, macOS, Linux)",
      browserRequirements: "Requires JavaScript. Fully functional on mobile and desktop.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD", availability: "https://schema.org/InStock" },
      isAccessibleForFree: true,
      featureList: Array.isArray(uiChrome.webAppFeatures) ? uiChrome.webAppFeatures : [
        "Up to 500 entries capacity",
        "Web Cryptography API randomness (crypto.getRandomValues)",
        "Per-slice custom probability weighting",
        "Mechanical tick & classic drum sound effects",
        "Automatic winner elimination",
        "Bulk paste from Excel & Google Sheets",
        "Multiple color palettes & dark mode",
        "Fullscreen presentation mode",
        "Shareable wheel links, QR codes & iframe embed",
        "Empirical frequency statistics & CSV export"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      description: "Free, cryptographically fair online spin wheels for names, decisions, classrooms, giveaways, and party games.",
      publisher: { "@id": `${SITE_URL}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${SITE_URL}/tools?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      logo: { "@type": "ImageObject", url: `${SITE_URL}/logo-512x512.png`, width: 512, height: 512 },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "spinthewheelsonline@gmail.com",
        url: `${SITE_URL}/contact`
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${selfUrl}#breadcrumbs`,
      itemListElement: breadcrumbItems
    },
    {
      "@type": "HowTo",
      "@id": `${selfUrl}#howto`,
      name: customT.howTo.title,
      description: customT.howTo.subtitle,
      totalTime: "PT1M",
      step: customT.howTo.steps.map((s: any) => ({
        "@type": "HowToStep",
        position: s.num,
        name: s.title,
        text: s.desc
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${selfUrl}#faq`,
      mainEntity: customT.faqs.map((f: any) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a }
      }))
    }
  ]
};

const schemaJson = JSON.stringify(schemaGraph).replace(/</g, "\\u003c");
const presetsJson = JSON.stringify(customT.presets).replace(/</g, "\\u003c");
const initialItemsJson = Array.isArray(defaultItems) && defaultItems.length
  ? JSON.stringify(defaultItems).replace(/</g, "\\u003c")
  : null;
const hasDeepTable = Boolean(hasToolDeepGuide && Array.isArray(tool?.deepSections) && tool.deepSections.some((s: any) => s && s.table));
const presetEntries = Object.entries(customT.presets || {}) as Array<[string, any]>;
---

<!doctype html>
<html lang={htmlLangAttr} dir={isRtl ? "rtl" : "ltr"} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  {customT.keywords && <meta name="keywords" content={customT.keywords} />}
  <meta name="author" content={SITE_NAME} />
  <meta name="robots" content={pageRobots} />
  <meta name="googlebot" content={pageRobots} />
  <meta name="application-name" content={SITE_NAME} />
  <meta name="theme-color" content="#F59E0B" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <link rel="canonical" href={canonicalUrl} />
  {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={langMeta?.locale || "en_US"} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={pageTitle} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImg} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/logo-192x192.png" />
  <link rel="manifest" href="/manifest.json" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Nunito:wght@400;600;700;800;900&display=swap" /></noscript>

  <link rel="stylesheet" href={ASSETS.cssHref} />
  <AnalyticsHead enableAds={true} />

  <script type="application/ld+json" set:html={schemaJson} />
  <script is:inline set:html={`window.stwol_presets = ${presetsJson};${initialItemsJson ? `\nwindow.stwol_initial_items = ${initialItemsJson};` : ""}`} />
</head>

<body>
  <a class="skip-link embed-hide" href="#tool">{uiChrome.skipToWheel || "Skip to Wheel Tool"}</a>
  <div class="embed-hide">
    <SiteHeader lang={langMeta} t={customT} chrome={uiChrome} hasWheelTool={true} currentSlug={slug} currentPath={selfPath} />
  </div>

  <main id="main-content">
    <div class="container">
      {slug && (
        <nav class="breadcrumb-nav embed-hide" aria-label="Breadcrumb navigation" style="padding: 12px 0 4px; font-size: 0.85rem; color: var(--text-muted); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <a href={isLocalizedHub ? `/${langCode}` : "/"} style="color: var(--text-muted); text-decoration: none;">{uiChrome.homeBreadcrumb || "Home"}</a>
          <span aria-hidden="true">&rsaquo;</span>
          <a href="/tools" style="color: var(--text-muted); text-decoration: none;">{uiChrome.allToolsBreadcrumb || "Tools"}</a>
          {activeCatObj && (
            <>
              <span aria-hidden="true">&rsaquo;</span>
              <a href={`/category/${activeCatObj.slug}`} style="color: var(--text-muted); text-decoration: none;">
                {uiChrome.categories?.[activeCatObj.name] || activeCatObj.name}
              </a>
            </>
          )}
          <span aria-hidden="true">&rsaquo;</span>
          <span style="color: var(--text-primary); font-weight: 600;" aria-current="page">{localizedWheelName}</span>
        </nav>
      )}

      <section class="hero-section hero-compact embed-hide" aria-labelledby="heroHeading">
        {tool?.category && (
          <div style="display:inline-block; margin-bottom:8px;">
            {activeCatObj ? (
              <a href={`/category/${activeCatObj.slug}`} style="display:inline-flex; align-items:center; gap:6px; background:rgba(245,158,11,0.12); color:#D97706; font-size:0.76rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; padding:4px 12px; border-radius:999px; border:1px solid rgba(245,158,11,0.25); text-decoration:none;">
                {activeCatObj.icon} {localizedCatName}
              </a>
            ) : (
              <span style="display:inline-flex; align-items:center; gap:6px; background:rgba(245,158,11,0.12); color:#D97706; font-size:0.76rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; padding:4px 12px; border-radius:999px; border:1px solid rgba(245,158,11,0.25);">
                🎯 {localizedCatName}
              </span>
            )}
          </div>
        )}
        <h1 class="hero-title" id="heroHeading">
          {customT.heroTitle} – <span>{customT.heroHighlight}</span>
        </h1>
        <p class="hero-subtitle">{customT.heroSubtitle}</p>
      </section>

      <!-- Interactive Canvas Wheel Island (Zero framework JS overhead) -->
      <section class="tool-section" id="tool" aria-label="Interactive Random Wheel Picker">
        <div class="tool-grid">
          <div class="wheel-stage">
            <div class="wheel-wrapper">
              <canvas id="wheel" width="440" height="440" role="img" aria-label="Interactive Spin Wheel Canvas — Click to Spin"></canvas>
              <div class="wheel-pointer" aria-hidden="true"></div>
              <button type="button" class="center-circle" onclick="window.stwol.spinWheel()" title={customT.ui.spinBtn} aria-label={customT.ui.spinBtn}>
                ▶
              </button>
            </div>

            <button class="spin-action-btn" id="spinBtn" type="button" onclick="window.stwol.spinWheel()" aria-label={customT.ui.spinBtn}>
              {customT.ui.spinBtn}
            </button>

            <div class="result-banner" aria-live="polite">
              <div class="result-banner-label">{customT.ui.resultDecided}</div>
              <div class="result-banner-value" id="resultValue"></div>
            </div>
          </div>

          <div class="control-panel">
            <div class="card">
              <div class="card-title">{customT.ui.addNamesHeading}</div>

              <div class="preset-chips-wrap" aria-label="Instant preset lists">
                {presetEntries.map(([key, val]) => (
                  <button class="preset-chip" type="button" onclick={`window.stwol.loadPreset('${key}')`}>
                    {val.label}
                  </button>
                ))}
              </div>

              <div class="entries-list" id="entriesList" role="list" aria-label="Current Wheel Items"></div>

              <div class="add-entry-row">
                <label for="newEntry" class="sr-only">Add an entry to the wheel</label>
                <input type="text" id="newEntry" class="entry-input" placeholder={customT.ui.inputPlaceholder} maxlength="50" autocomplete="off" onkeydown="if(event.key==='Enter') window.stwol.addEntry();" />
                <button class="btn-primary" type="button" onclick="window.stwol.addEntry()" aria-label="Add entry to list">
                  + {customT.ui.addBtn}
                </button>
              </div>

              <button class="btn-secondary" type="button" onclick="window.stwol.toggleBulk()" style="width:100%; margin-bottom:8px;">
                {customT.ui.bulkBtn}
              </button>

              <div class="bulk-area" id="bulkArea" hidden>
                <label for="bulkInput" class="sr-only">Paste multiple items</label>
                <textarea id="bulkInput" class="bulk-textarea" placeholder={customT.ui.bulkPlaceholder}></textarea>
                <div class="bulk-actions">
                  <button class="btn-secondary" type="button" onclick="window.stwol.toggleBulk()">{customT.ui.bulkCloseBtn}</button>
                  <button class="btn-primary" type="button" onclick="window.stwol.addBulkEntries()">{customT.ui.bulkAddBtn}</button>
                </div>
              </div>

              <div class="action-grid">
                <button class="btn-secondary" type="button" onclick="window.stwol.shuffleEntries()" title="Randomize item order">{customT.ui.shuffleBtn}</button>
                <button class="btn-secondary" type="button" onclick="window.stwol.sortEntries()" title="Alphabetical sort">{customT.ui.sortBtn}</button>
                <button class="btn-secondary" type="button" onclick="window.stwol.clearAllEntries()" title="Clear list">{customT.ui.clearAllBtn}</button>
              </div>

              {slug && (
                <button class="btn-secondary" type="button" onclick="window.stwol.resetDefaultEntries()" style="width:100%; margin-top:8px;" title={uiChrome.resetDefaultsTitle || "Restore original default wheel entries"}>
                  ↺ {uiChrome.resetDefaults || "Reset to Default Entries"}
                </button>
              )}
            </div>

            <div class="card">
              <div class="card-title">{customT.ui.themesHeading}</div>
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <label for="themeSelect" class="setting-label">{uiChrome.paletteTheme || "Palette Theme"}</label>
                <select id="themeSelect" class="setting-select" onchange="window.stwol.setTheme(this.value)">
                  <option value="rainbow" selected>{uiChrome.themeRainbow || "🌈 Rainbow Classic"}</option>
                  <option value="casino">{uiChrome.themeCasino || "🎰 Casino Gold"}</option>
                  <option value="neon">{uiChrome.themeNeon || "⚡ Cyber Neon"}</option>
                  <option value="pastel">{uiChrome.themePastel || "🌸 Pastel Dream"}</option>
                  <option value="sunset">{uiChrome.themeSunset || "🌅 Sunset Coral"}</option>
                  <option value="emerald">{uiChrome.themeEmerald || "🌲 Emerald Forest"}</option>
                  <option value="ocean">{uiChrome.themeOcean || "🌊 Ocean Breeze"}</option>
                  <option value="luxe">{uiChrome.themeLuxe || "🌌 Dark Luxe"}</option>
                </select>
              </div>
            </div>

            <div class="card embed-hide" id="setting">
              <div class="card-title">{customT.ui.settingsHeading}</div>

              <div class="setting-row">
                <label for="spinDuration" class="setting-label">{customT.ui.spinDuration}</label>
                <div style="display:flex; align-items:center; gap:8px;">
                  <input type="range" id="spinDuration" class="setting-slider" min="2" max="20" value="5" step="0.5" oninput="document.getElementById('durDisp').textContent = this.value + 's'" />
                  <span id="durDisp" style="font-weight:700; font-size:0.85rem; min-width:32px;">5s</span>
                </div>
              </div>

              <div class="setting-row">
                <label for="soundSelect" class="setting-label">{customT.ui.soundEffect}</label>
                <select id="soundSelect" class="setting-select">
                  <option value="tick" selected>{customT.ui.soundTick}</option>
                  <option value="drum">{customT.ui.soundDrum}</option>
                  <option value="none">{customT.ui.soundNone}</option>
                </select>
              </div>

              <div class="setting-row">
                <label for="volumeSlider" class="setting-label">{customT.ui.soundVolume}</label>
                <input type="range" id="volumeSlider" class="setting-slider" min="0" max="1" value="0.6" step="0.05" oninput="window.stwol.setVolume(this.value)" />
              </div>

              <div class="setting-row">
                <div>
                  <div class="setting-label">{customT.ui.removeWinner}</div>
                  <div style="font-size:0.78rem; color:var(--text-muted);">{customT.ui.removeWinnerDesc}</div>
                </div>
                <label class="toggle-switch">
                  <input type="checkbox" id="removeWinner" aria-label={customT.ui.removeWinner} />
                  <span class="toggle-track"></span>
                </label>
              </div>

              <div class="setting-row">
                <span class="setting-label">{customT.ui.showPopup}</span>
                <label class="toggle-switch">
